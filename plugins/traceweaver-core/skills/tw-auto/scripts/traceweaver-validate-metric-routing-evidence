class VError < StandardError; end
def canon(value)
  return value.map { |item| canon(item) } if value.is_a?(Array)
  return value.keys.sort.to_h { |key| [key, canon(value[key])] } if value.is_a?(Hash)
  value
end
def ident(value, field)
  payload = value.reject do |key, _value|
    key == field
  end
  "sha256:#{Digest::SHA256.hexdigest(JSON.generate(canon(payload)))}"
end
def digest?(value); value.is_a?(String) && value.match?(/\Asha256:[0-9a-f]{64}\z/); end
def rat(v); Rational(v.to_s) rescue raise(VError,"rational") end
def path!(r,l); raise VError,"path" unless l.is_a?(String)&&!l.empty?&&!Pathname.new(l).absolute?&&l.split("/").all?{|x|x!=""&&x!="."&&x!=".."}; p=File.join(r,l); c=r;l.split("/").each{|x|c=File.join(c,x);raise VError,"path" if File.symlink?(c)};raise VError,"path" unless File.file?(p)&&File.size(p)<=MAX; q=File.realpath(p);raise VError,"path" unless q.start_with?("#{r}/");q end
def trace!(v); t=v["_traceweaver"]; return unless t; raise VError,"trace" unless t.is_a?(Hash)&&t.keys.sort==%w[req trace verifies]&&t["trace"]=="TRACE-TW-073"&&t["verifies"]=="VER-TW-093"&&t["req"].match?(/\AREQ-TW-(124|125|126|127|128|129)(,REQ-TW-(124|125|126|127|128|129))*\z/) end
def exact!(value, keys, code, trace: false)
  raise VError, code unless value.is_a?(Hash)
  trace!(value) if trace
  actual = value.keys - (trace ? ["_traceweaver"] : [])
  raise VError, code unless actual.sort == keys.sort
end
def allowed!(value, keys, code)
  raise VError, code unless value.is_a?(Hash)
  trace!(value)
  raise VError, code unless (value.keys - keys - ["_traceweaver"]).empty?
end
def primitive!(value)
  case value
  when Hash then value.each_value { |entry| primitive!(entry) }
  when Array then value.each { |entry| primitive!(entry) }
  when Float then raise VError, "float"
  when String, Integer, TrueClass, FalseClass, NilClass then value
  else raise VError, "primitive"
  end
end
def json!(raw)
  value = JSON.parse(raw)
  primitive!(value)
  trace!(value) if value.is_a?(Hash)
  exact = JSON.generate(canon(value))
  return [value, false] if raw == exact || raw == "#{exact}\n"
  [value, true]
rescue JSON::ParserError
  raise VError, "json"
end
def records_for(root, locator)
  file = path!(root, locator)
  values = if locator.end_with?(".jsonl")
             File.binread(file).lines.map { |line| json!(line) }
           elsif locator.end_with?(".json")
             [json!(File.binread(file))]
           else
             [[YAML.safe_load(File.binread(file), permitted_classes: [], aliases: false), false]]
           end
  values.each { |value, _noncanonical| trace!(value) if value.is_a?(Hash) }
  [values, "sha256:#{Digest::SHA256.file(file).hexdigest}"]
rescue Psych::Exception
  raise VError, "yaml"
end
def validate_record!(record)
  primitive!(record)
  case record["schema_version"]
  when "tw-metric-routing-fixture/1"
    exact!(record, %w[category schema_version test], "fixture", trace: true)
    test = record["test"]
    case record["category"]
    when "locator"
      exact!(test, %w[locator], "locator")
    when "pairs"
      allowed!(test, %w[candidate_definition_identity cell_identity changed_axis control_definition_identity corpus_identity exclusion_phase pair_ids policy_identity replacement_count sign_design stopping], "pairs")
    when "policy"
      allowed!(test, %w[candidate_definition_identity cell_identity changed_axis control_definition_identity corpus_identity exclusion_phase pair_ids policy_identity replacement_count sign_design stopping], "policy_fixture")
    when "quality"
      allowed!(test, %w[efficiency_pairs hard_invariants paired_quality_differences rater_metadata rating_packets score_packets], "quality")
      Array(test["hard_invariants"]).each { |item| exact!(item, %w[id observed], "quality_invariant") }
      Array(test["score_packets"]).each { |item| exact!(item, %w[dimensions scenario_id], "quality_score") }
      Array(test["rater_metadata"]).each { |item| exact!(item, %w[blinded id independent], "quality_rater") }
      Array(test["rating_packets"]).each { |item| exact!(item, %w[ratings scenario_id], "quality_rating") }
      Array(test["efficiency_pairs"]).each { |item| exact!(item, %w[baseline_tokens candidate_tokens], "quality_efficiency") }
    when "accounting"
      exact!(test, %w[exclusions maximum_valid_pairs pairs stopping], "accounting")
      Array(test["exclusions"]).each { |item| exact!(item, %w[pair_id phase], "accounting_exclusion") }
      Array(test["pairs"]).each do |pair|
        exact!(pair, %w[baseline candidate pair_id], "accounting_pair")
        %w[baseline candidate].each do |side|
          workflow = pair[side]
          exact!(workflow, %w[complete executions monotonic_latency_ns], "accounting_workflow")
          Array(workflow["executions"]).each { |execution| exact!(execution, %w[cached_input direct_input execution_id output scope], "accounting_execution") }
        end
      end
    when "sufficiency"
      allowed!(test, %w[declared_delivery_cost negative_control positive_scenario_completed prohibited_behavior retry_bounded state_promotion], "sufficiency")
    when "qualification"
      allowed!(test, %w[bindings cell_identity claim_boundary claim_hold_assertion evidence_transfer expired observed_bindings structural_current validation_identity verification_current], "qualification")
    else
      raise VError, "fixture_category"
    end
  when "tw-metric-routing-mutation/1"
    exact!(record, %w[base category mutations schema_version], "mutation", trace: true)
    raise VError, "mutation" unless MUTATION_BASES.key?(record["category"]) && record["mutations"].is_a?(Array)
    expected_base = MUTATION_BASES.fetch(record["category"])
    raise VError, "mutation" unless record["base"] == expected_base
    record["mutations"].each do |mutation|
      keys = mutation["op"] == "delete" ? %w[op path] : %w[op path value]
      exact!(mutation, keys, "mutation_item")
      raise VError, "mutation_item" unless %w[add delete replace].include?(mutation["op"]) && MUTATION_PATHS.fetch(record["category"]).include?(mutation["path"])
    end
  when "tw-metric-routing-observation/1"
    exact!(record, %w[cell_id collector_id content_free counts execution_identity observation_identity schema_version signature_suite trust_registry_digest trust_root_id], "observation", trace: true)
    exact!(record["counts"], %w[paired_runs], "observation_counts")
  when "tw-metric-routing-attestation/1"
    exact!(record, %w[attestation_id cell_id collector_id collector_key_spki_sha256 collector_role estimated execution nonce observation_identity schema_version signature signature_suite trust_registry_digest trust_root_id], "attestation", trace: true)
    exact!(record["execution"], %w[accounting_identity clock_identity outcome_identity overflow_identity request_identity response_identity served_model_identity topology_identity], "attestation_execution")
  when "tw-metric-routing-collector-trust/1"
    exact!(record, %w[collectors schema_version trust_root_id], "trust", trace: true)
    raise VError, "trust" unless record["collectors"].is_a?(Array) && record["collectors"].length == 1
    exact!(record["collectors"][0], %w[collector_id public_key_pem public_key_spki_sha256 role signature_suite], "trust_collector")
  when "tw-metric-routing-policy/1"
    exact!(record, %w[accounting cell corpus_identity exclusions method_suite policy_identity quality reset_triggers schema_version sign_design signature_suite stopping trust], "policy", trace: true)
    exact!(record["sign_design"], %w[alpha alternative_favorable_probability fixed_minimum_valid_positive_pairs fixed_stopping maximum_valid_pairs null_favorable_probability power_target powered_minimum], "policy_sign")
    exact!(record["cell"], POLICY_CELL_FIELDS, "policy_cell")
    exact!(record["trust"], POLICY_TRUST_FIELDS, "policy_trust")
    exact!(record["stopping"], %w[fixed maximum_valid_pairs], "policy_stopping")
    exact!(record["exclusions"], %w[phase replacement_cap_fraction replacement_cap_pairs], "policy_exclusions")
    exact!(record["quality"], %w[absolute_score_floor agreement_method blinded_independent_raters_minimum lower_bound minimum_pairwise_kappa noninferiority_method], "policy_quality")
    exact!(record["accounting"], %w[aggregation interval_method latency_upper_bound token_lower_bound], "policy_accounting")
  when "tw-metric-routing-corpus/1"
    exact!(record, %w[corpus_id corpus_identity scenario_count schema_version], "corpus", trace: true)
  else
    raise VError, "schema_version"
  end
end
def sign_cutoff(n, alpha)
  (0..n).find { |candidate| (candidate..n).sum { |count| Rational(choose(n, count), 2**n) } <= alpha }
end
def sign_power(n, cutoff, favorable_probability)
  (cutoff..n).sum { |count| Rational(choose(n, count)) * favorable_probability**count * (1 - favorable_probability)**(n - count) }
end
def validate_sign_design!(sign)
  exact!(sign, %w[alpha alternative_favorable_probability fixed_minimum_valid_positive_pairs fixed_stopping maximum_valid_pairs null_favorable_probability power_target powered_minimum], "policy_sign")
  alpha = rat(sign["alpha"])
  alternative = rat(sign["alternative_favorable_probability"])
  target = rat(sign["power_target"])
  minimum = sign["fixed_minimum_valid_positive_pairs"]
  maximum = sign["maximum_valid_pairs"]
  raise VError, "policy_power" unless alpha == Rational(1, 20) && rat(sign["null_favorable_probability"]) == Rational(1, 2) && alternative == Rational(4, 5) && target == Rational(4, 5)
  raise VError, "policy_power" unless minimum == 10 && maximum == 18 && sign["fixed_stopping"] == true
  computed = (minimum..maximum).find do |count|
    cutoff = sign_cutoff(count, alpha)
    cutoff && sign_power(count, cutoff, alternative) >= target
  end
  raise VError, "policy_power" unless computed == 18 && sign["powered_minimum"] == computed && sign_cutoff(computed, alpha) == 13
  computed
end
def template_party!(value, code)
  exact!(value, %w[identity relationship], code)
  raise VError, code unless value.values.all? { |field| field.is_a?(String) && field.start_with?("required_future_") }
end
def required_placeholders!(record, fields, code)
  raise VError, code unless fields.all? { |field| record[field].is_a?(String) && record[field].start_with?("required_future_") }
end
def validate_evidence_templates!(root, contracts)
  exact!(contracts, %w[result validation verification], "template_contract")
  expected = {
    "result" => ["#{ROOT_FIX}/result-tw-050-template.json", "tw-metric-routing-result-template/1", "pending_no_observed_result"],
    "validation" => ["#{ROOT_FIX}/val-tw-041-template.yml", "tw-metric-routing-validation-template/1", "planned_not_accepted"],
    "verification" => ["#{ROOT_FIX}/ver-tw-093-template.yml", "tw-metric-routing-verification-template/1", "pending_host_and_provider_evidence"]
  }
  expected.each do |name, values|
    exact!(contracts.fetch(name), %w[locator schema_version status], "template_contract")
    raise VError, "template_contract" unless contracts[name] == {"locator" => values[0], "schema_version" => values[1], "status" => values[2]}
  end

  result = records_for(root, expected.dig("result", 0)).first.fetch(0).fetch(0)
  exact!(result, %w[accounting_summary candidate_identity claim_disposition corpus_identity evidence_path exact_cell_identity fixture_boundary method_suite outcome pair_summary policy_identity quality_summary raters raw_observation_locators requirements result_id reviewer schema_version state_summary status sufficiency_summary tested_ref trust_identity], "result_template", trace: true)
  raise VError, "result_template" unless result["schema_version"] == expected.dig("result", 1) && result["status"] == expected.dig("result", 2) && result["result_id"] == "RESULT-TW-050" && result["requirements"] == %w[REQ-TW-124 REQ-TW-125 REQ-TW-126 REQ-TW-127 REQ-TW-128 REQ-TW-129] && result["method_suite"] == "tw-metric-exact-paired/1" && result["claim_disposition"] == HELD && result["fixture_boundary"] == "template_only_not_a_result" && result["outcome"] == "pending_provider_and_host_evidence"
  required_placeholders!(result, %w[accounting_summary candidate_identity corpus_identity evidence_path exact_cell_identity policy_identity quality_summary state_summary sufficiency_summary tested_ref trust_identity], "result_template")
  template_party!(result["reviewer"], "result_template")
  raise VError, "result_template" unless result["raters"].is_a?(Array) && result["raters"].length == 1 && result["raw_observation_locators"] == ["required_future_repository_relative_observation_locator"]
  template_party!(result["raters"].first, "result_template")
  exact!(result["pair_summary"], %w[absolute_values distribution_summary exclusions invalid_pair_count partial_pair_count percentages uncertainty valid_pair_count], "result_template")
  required_placeholders!(result["pair_summary"], %w[absolute_values distribution_summary percentages uncertainty], "result_template")
  raise VError, "result_template" unless result["pair_summary"]["exclusions"] == ["required_future_pre_result_exclusion"] && result["pair_summary"].values_at("valid_pair_count", "invalid_pair_count", "partial_pair_count").all? { |value| value == "required_nonnegative_integer" }

  verification = records_for(root, expected.dig("verification", 0)).first.fetch(0).fetch(0)
  exact!(verification, %w[actual_result candidate_identity claim_disposition command corpus_identity deviations evidence_path exact_cell_identity exit_status expected_result fixture_boundary method method_suite outcome policy_identity requirements schema_version setup status tested_ref trust_identity verification_id verifier], "verification_template", trace: true)
  raise VError, "verification_template" unless verification["schema_version"] == expected.dig("verification", 1) && verification["status"] == expected.dig("verification", 2) && verification["verification_id"] == "VER-TW-093" && verification["requirements"] == %w[REQ-TW-124 REQ-TW-125 REQ-TW-126 REQ-TW-127 REQ-TW-128 REQ-TW-129] && verification["method_suite"] == "tw-metric-exact-paired/1" && verification["claim_disposition"] == HELD && verification["fixture_boundary"] == "template_only_not_a_verification_pass" && verification["outcome"] == "pending_host_and_provider_evidence"
  required_placeholders!(verification, %w[actual_result candidate_identity command corpus_identity deviations evidence_path exact_cell_identity exit_status expected_result method policy_identity setup tested_ref trust_identity], "verification_template")
  template_party!(verification["verifier"], "verification_template")

  validation = records_for(root, expected.dig("validation", 0)).first.fetch(0).fetch(0)
  exact!(validation, %w[acceptance_signal actual_result candidate_identity claim_disposition corpus_identity deviations evidence_path exact_cell_identity fixture_boundary method_suite outcome owner policy_identity rater relationship_and_independence representative_scenario requirements schema_version status trust_identity validation_id], "validation_template", trace: true)
  raise VError, "validation_template" unless validation["schema_version"] == expected.dig("validation", 1) && validation["status"] == expected.dig("validation", 2) && validation["validation_id"] == "VAL-TW-041" && validation["requirements"] == %w[REQ-TW-124 REQ-TW-125 REQ-TW-126 REQ-TW-127 REQ-TW-128 REQ-TW-129] && validation["method_suite"] == "tw-metric-exact-paired/1" && validation["claim_disposition"] == HELD && validation["fixture_boundary"] == "template_only_not_stakeholder_validation" && validation["outcome"] == "planned_not_accepted" && validation["owner"] == "Oxiom Systems_or_approved_independent_proxy"
  required_placeholders!(validation, %w[acceptance_signal actual_result candidate_identity corpus_identity deviations evidence_path exact_cell_identity policy_identity relationship_and_independence representative_scenario trust_identity], "validation_template")
  template_party!(validation["rater"], "validation_template")
end
def validate_policy_contract!(root, raw)
  policy = raw.find { |record| record["schema_version"] == "tw-metric-routing-policy/1" }
  corpus = raw.find { |record| record["schema_version"] == "tw-metric-routing-corpus/1" }
  return [nil, nil] unless policy || corpus
  raise VError, "policy_contract" unless policy && corpus
  validate_record!(policy)
  validate_record!(corpus)
  trust = records_for(root, "#{ROOT_FIX}/collector-trust.yml").first.fetch(0).fetch(0)
  collector = trust.fetch("collectors").fetch(0)
  trust_digest = "sha256:#{Digest::SHA256.file(path!(root, "#{ROOT_FIX}/collector-trust.yml")).hexdigest}"
  raise VError, "policy_contract" unless policy["policy_identity"] == ident(policy, "policy_identity") && corpus["corpus_identity"] == ident(corpus, "corpus_identity") && corpus["scenario_count"] == 10
  raise VError, "policy_contract" unless policy["method_suite"] == "tw-metric-exact-paired/1" && policy["corpus_identity"] == corpus["corpus_identity"] && policy["signature_suite"] == "rsa-sha256-pkcs1-v1_5"
  raise VError, "policy_contract" unless policy["cell"]["changed_axis"] == "route_strategy" && (POLICY_CELL_FIELDS - ["changed_axis"]).all? { |field| digest?(policy["cell"][field]) }
  raise VError, "policy_contract" unless policy["trust"] == {"collector_id" => collector["collector_id"], "collector_key_spki_sha256" => collector["public_key_spki_sha256"], "trust_registry_digest" => trust_digest, "trust_root_id" => trust["trust_root_id"]}
  raise VError, "policy_contract" unless policy["stopping"] == {"fixed" => true, "maximum_valid_pairs" => 18} && policy["exclusions"] == {"phase" => "pre_result", "replacement_cap_fraction" => "1/10", "replacement_cap_pairs" => 1}
  raise VError, "policy_contract" unless policy["quality"] == {"absolute_score_floor"=>3, "agreement_method"=>"minimum_pairwise_quadratic_weighted_kappa", "blinded_independent_raters_minimum"=>2, "lower_bound"=>"-1/4", "minimum_pairwise_kappa"=>"4/5", "noninferiority_method"=>"one_sided_distribution_free_order_statistic"}
  raise VError, "policy_contract" unless policy["accounting"] == {"aggregation"=>"whole_workflow_once", "interval_method"=>"one_sided_distribution_free_order_statistic", "latency_upper_bound"=>"6/5", "token_lower_bound"=>"1/5"}
  raise VError, "policy_contract" unless policy["reset_triggers"] == POLICY_RESET_TRIGGERS
  validate_sign_design!(policy["sign_design"])
  [policy, corpus]
end
def base(root, category)
  values, = records_for(root, MUTATION_BASES.fetch(category))
  validate_record!(values.fetch(0).fetch(0))
  values.fetch(0).fetch(0)
end
def materialize(root, records)
  records.flat_map do |value, noncanonical|
    next [[value, noncanonical]] if noncanonical || value["schema_version"] != "tw-metric-routing-mutation/1"
    validate_record!(value)
    document = JSON.parse(JSON.generate(base(root, value["category"])))
    value["mutations"].each do |mutation|
      target = document
      parts = mutation["path"].split(".")
      leaf = parts.pop
      parts.each do |part|
        raise VError, "mutation_item" unless target[part].is_a?(Hash)
        target = target[part]
      end
      case mutation["op"]
      when "add"
        raise VError, "mutation_item" if target.key?(leaf)
        target[leaf] = mutation["value"]
      when "replace"
        raise VError, "mutation_item" unless target.key?(leaf)
        target[leaf] = mutation["value"]
      when "delete"
        raise VError, "mutation_item" unless target.key?(leaf)
        target.delete(leaf)
      end
    end
    [[document, false]]
  end
end
def choose(n, k); return 0 if k < 0 || k > n; k = [k, n-k].min; (1..k).reduce(1) { |value, index| value * (n-k+index) / index } end
def rank(n); (1..n).select{|k|(0..k-1).sum{|j|Rational(choose(n,j),2**n)}<=Rational(1,20)}.max end
def kappa(a,b); w=->(x,y){Rational((x-y)**2,16)};o=a.zip(b).sum{|x,y|w[x,y]}/a.length;e=(0..4).to_a.product((0..4).to_a).sum{|x,y|w[x,y]*Rational(a.count(x)*b.count(y),a.length**2)};e>0 ? 1-o/e:nil end
def fixture_tests(records, category)
  records.select { |record| record["schema_version"] == "tw-metric-routing-fixture/1" && record["category"] == category }.map do |record|
    validate_record!(record)
    record["test"]
  end
end

def default_doc(root, locator)
  values, = records_for(root, locator)
  raise VError, "default_doc" unless values.length == 1 && values[0][1] == false
  values[0][0]
end

def attestation_assessment(root, records)
  return ["held_attestation_noncanonical", {}] if records.any? { |_record, noncanonical| noncanonical }
  raw = records.map(&:first)
  locators = raw.select { |record| record["category"] == "locator" }
  locators.each do |record|
    validate_record!(record)
    begin
      path!(root, record.dig("test", "locator"))
    rescue VError
      return ["held_locator_unsafe", {}]
    end
  end
  materialized = materialize(root, records).map(&:first)
  observation = materialized.find { |record| record["schema_version"] == "tw-metric-routing-observation/1" }
  observation ||= default_doc(root, "#{ROOT_FIX}/observation-valid.json")
  return ["held_privacy_content_forbidden", {}] if %w[prompt tool_result secret source_content].any? { |field| observation.key?(field) }
  attestations = materialized.select { |record| record["schema_version"] == "tw-metric-routing-attestation/1" }
  return [nil, {}] if attestations.empty?

  trust = materialized.find { |record| record["schema_version"] == "tw-metric-routing-collector-trust/1" }
  trust ||= default_doc(root, "#{ROOT_FIX}/collector-trust.yml")
  begin
    validate_record!(trust)
    validate_record!(observation)
    collector = trust.fetch("collectors").fetch(0)
    key = OpenSSL::PKey.read(collector.fetch("public_key_pem"))
    trust_digest = "sha256:#{Digest::SHA256.file(path!(root, "#{ROOT_FIX}/collector-trust.yml")).hexdigest}"
    valid_key = key.is_a?(OpenSSL::PKey::RSA) && key.n.num_bits >= 2048 && key.e.to_i >= 65_537 &&
      collector["public_key_spki_sha256"] == "sha256:#{Digest::SHA256.hexdigest(key.public_key.to_der)}"
    valid_observation = observation["content_free"] == true &&
      observation.dig("counts", "paired_runs").is_a?(Integer) && observation.dig("counts", "paired_runs").positive? &&
      observation["cell_id"].is_a?(String) && !observation["cell_id"].empty? &&
      observation["collector_id"] == collector["collector_id"] &&
      digest?(observation["execution_identity"]) &&
      observation["observation_identity"] == ident(observation, "observation_identity") &&
      observation["trust_registry_digest"] == trust_digest &&
      observation["trust_root_id"] == trust["trust_root_id"] &&
      observation["signature_suite"] == collector["signature_suite"]
    return ["held_attestation_trust_or_suite_mismatch", {}] unless valid_key && valid_observation
  rescue OpenSSL::PKey::PKeyError, KeyError, VError
    return ["held_attestation_trust_or_suite_mismatch", {}]
  end

  replay_keys = []
  attestations.each do |attestation|
    allowed!(attestation, %w[attestation_id cell_id collector_id collector_key_spki_sha256 collector_role estimated execution nonce observation_identity schema_version signature signature_suite trust_registry_digest trust_root_id], "attestation_schema")
    required = %w[attestation_id cell_id collector_id collector_key_spki_sha256 collector_role estimated execution nonce observation_identity schema_version signature_suite trust_registry_digest trust_root_id]
    return ["held_attestation_incomplete", {}] unless required.all? { |field| attestation.key?(field) }
    return ["held_attestation_self_attested", {}] unless attestation["collector_role"] == "independent_collector"
    return ["held_attestation_trust_or_suite_mismatch", {}] unless attestation["collector_id"] == collector["collector_id"] &&
      attestation["collector_key_spki_sha256"] == collector["public_key_spki_sha256"] &&
      attestation["trust_registry_digest"] == trust_digest &&
      attestation["trust_root_id"] == trust["trust_root_id"] &&
      attestation["signature_suite"] == collector["signature_suite"]
    return ["held_attestation_estimated", {}] unless attestation["estimated"] == false
    return ["held_attestation_cross_cell", {}] unless attestation["cell_id"] == observation["cell_id"] && attestation["observation_identity"] == observation["observation_identity"]
    execution = attestation["execution"]
    return ["held_attestation_incomplete", {}] unless execution.is_a?(Hash) && execution.keys.sort == EXECUTION_FIELDS && EXECUTION_FIELDS.all? { |field| digest?(execution[field]) }
    return ["held_attestation_incomplete", {}] unless observation["execution_identity"] == ident(execution, "none")
    return ["held_attestation_signature_missing", {}] unless attestation["signature"].is_a?(String) && !attestation["signature"].empty?
    begin
      signature = Base64.strict_decode64(attestation["signature"])
      signed = JSON.generate(canon(attestation.reject { |field, _value| field == "signature" }))
      return ["held_attestation_signature_invalid", {}] unless key.verify(OpenSSL::Digest::SHA256.new, signature, signed)
    rescue ArgumentError, OpenSSL::PKey::PKeyError
      return ["held_attestation_signature_invalid", {}]
    end
    replay_keys << [attestation["nonce"], ident(attestation, "signature"), ident(execution, "none"), attestation["cell_id"]]
  end
  return ["held_attestation_replayed", {}] unless replay_keys.uniq.length == replay_keys.length
  [nil, {"attestation_count" => attestations.length}]
end

def pair_assessment(root, raw, policy, corpus)
  expected_policy = policy || default_doc(root, "#{ROOT_FIX}/policy-valid.yml")
  expected_corpus = corpus || default_doc(root, "#{ROOT_FIX}/corpus-valid.json")
  (fixture_tests(raw, "policy") + fixture_tests(raw, "pairs")).each do |test|
    allowed!(test, %w[candidate_definition_identity cell_identity changed_axis control_definition_identity corpus_identity exclusion_phase pair_ids policy_identity replacement_count sign_design stopping], "pair_schema")
    return "held_policy_identity_mismatch" if test["policy_identity"] && test["policy_identity"] != expected_policy["policy_identity"]
    return "held_corpus_identity_mismatch" if test["corpus_identity"] && test["corpus_identity"] != expected_corpus["corpus_identity"]
    return "held_adaptive_stopping" if test["stopping"] == "adaptive"
    return "held_post_result_exclusion" if test["exclusion_phase"] == "post_result"
    return "held_replacement_over_cap" if test["replacement_count"].is_a?(Integer) && test["replacement_count"] > 1
    return "held_duplicate_pair" if test["pair_ids"].is_a?(Array) && test["pair_ids"].uniq.length != test["pair_ids"].length
    return "held_changed_axis" if test.key?("changed_axis") && test["changed_axis"] != "route_strategy"
    return "held_pilot_or_underpowered" if test["pair_ids"].is_a?(Array) && test["pair_ids"].length < 10
    if test["pair_ids"].is_a?(Array) && test["pair_ids"].length >= 10
      cell = expected_policy.fetch("cell")
      return "held_changed_axis" unless test["cell_identity"] == cell["route_identity"] &&
        test["control_definition_identity"] == cell["control_definition_identity"] &&
        test["candidate_definition_identity"] == cell["candidate_definition_identity"]
    end
    validate_sign_design!(test["sign_design"]) if test["sign_design"]
  end
  nil
end

def quality_assessment(raw)
  details = {}
  fixture_tests(raw, "quality").each do |test|
    allowed!(test, %w[efficiency_pairs hard_invariants paired_quality_differences rater_metadata rating_packets score_packets], "quality")
    invariants = test["hard_invariants"]
    return ["held_quality_hard_invariant", details] unless invariants.is_a?(Array) && !invariants.empty? && invariants.all? { |item| exact!(item, %w[id observed], "quality_invariant"); item["id"].is_a?(String) && item["observed"] == true }
    scores = test["score_packets"]
    if test["efficiency_pairs"] && scores.is_a?(Array) && scores.any? { |packet| packet.is_a?(Hash) && packet["dimensions"].is_a?(Hash) && packet["dimensions"].values.any? { |score| score.is_a?(Integer) && score < 3 } }
      return ["held_quality_conjunctive_failure", details]
    end
    return ["held_quality_floor", details] unless scores.is_a?(Array) && !scores.empty? && scores.all? { |packet| exact!(packet, %w[dimensions scenario_id], "quality_score"); packet["dimensions"].is_a?(Hash) && !packet["dimensions"].empty? && packet["dimensions"].values.all? { |score| score.is_a?(Integer) && (3..4).cover?(score) } }
    raters = test["rater_metadata"]
    return ["held_quality_missing_rating", details] unless raters.is_a?(Array) && raters.length >= 2 && raters.all? { |rater| exact!(rater, %w[blinded id independent], "quality_rater"); rater["id"].is_a?(String) }
    ids = raters.map { |rater| rater["id"] }
    return ["held_quality_missing_rating", details] unless ids.uniq.length == ids.length
    return ["held_quality_unblinded", details] unless raters.all? { |rater| rater["blinded"] == true }
    return ["held_quality_nonindependent", details] unless raters.all? { |rater| rater["independent"] == true }
    packets = test["rating_packets"]
    return ["held_quality_missing_rating", details] unless packets.is_a?(Array) && !packets.empty? && packets.all? { |packet| exact!(packet, %w[ratings scenario_id], "quality_rating"); packet["scenario_id"].is_a?(String) && packet["ratings"].is_a?(Hash) && packet["ratings"].keys.sort == ids.sort && packet["ratings"].values.all? { |rating| rating.is_a?(Integer) && (0..4).cover?(rating) } }
    kappas = ids.combination(2).map { |left, right| kappa(packets.map { |packet| packet["ratings"][left] }, packets.map { |packet| packet["ratings"][right] }) }
    return ["held_quality_kappa_undefined", details] if kappas.any?(&:nil?)
    details["minimum_pairwise_kappa"] = kappas.min.to_s
    return ["held_quality_kappa_below_threshold", details] if kappas.min < Rational(4, 5)
    differences = test["paired_quality_differences"]
    return ["held_quality_noninferiority_below_threshold", details] unless differences.is_a?(Array) && differences.length >= 10
    values = differences.map { |value| rat(value) }.sort
    lower = values.fetch(rank(values.length) - 1)
    details["quality_difference_lower_bound"] = lower.to_s
    return ["held_quality_noninferiority_below_threshold", details] if lower < Rational(-1, 4)
  end
  [nil, details]
end

def workflow_summary(workflow)
  exact!(workflow, %w[complete executions monotonic_latency_ns], "accounting_workflow")
  raise VError, "accounting_workflow" unless workflow["complete"] == true && workflow["monotonic_latency_ns"].is_a?(Integer) && workflow["monotonic_latency_ns"].positive? && workflow["executions"].is_a?(Array) && !workflow["executions"].empty?
  ids = []
  totals = {"cached_input" => 0, "direct_input" => 0, "output" => 0}
  scope_counts = Hash.new(0)
  workflow["executions"].each do |execution|
    exact!(execution, %w[cached_input direct_input execution_id output scope], "accounting_execution")
    raise VError, "accounting_execution" unless execution["execution_id"].is_a?(String) && %w[coordinator child retry shard].include?(execution["scope"]) && %w[cached_input direct_input output].all? { |field| execution[field].is_a?(Integer) && execution[field] >= 0 }
    ids << execution["execution_id"]
    %w[cached_input direct_input output].each { |field| totals[field] += execution[field] }
    scope_counts[execution["scope"]] += 1
  end
  summary = totals.merge(
    "execution_count" => ids.length,
    "monotonic_latency_ns" => workflow["monotonic_latency_ns"],
    "scope_counts" => %w[child coordinator retry shard].to_h { |scope| [scope, scope_counts[scope]] },
    "total_tokens" => totals.values.sum
  )
  [summary, ids]
end

def rational_distribution(values)
  sorted = values.sort
  midpoint = sorted.length / 2
  median = sorted.length.odd? ? sorted[midpoint] : (sorted[midpoint - 1] + sorted[midpoint]) / 2
  {"maximum" => sorted.last.to_s, "median" => median.to_s, "minimum" => sorted.first.to_s}
end

def accounting_assessment(raw)
  details = {}
  fixture_tests(raw, "accounting").each do |test|
    exact!(test, %w[exclusions maximum_valid_pairs pairs stopping], "accounting")
    return ["held_adaptive_stopping", details] unless test["stopping"] == "fixed" && test["maximum_valid_pairs"] == 18
    return ["held_post_result_exclusion", details] unless test["exclusions"].is_a?(Array) && test["exclusions"].all? { |entry| exact!(entry, %w[pair_id phase], "accounting_exclusion"); entry["phase"] == "pre_result" && entry["pair_id"].is_a?(String) }
    return ["held_accounting_underpowered", details] unless test["pairs"].is_a?(Array)
    excluded = test["exclusions"].map { |entry| entry["pair_id"] }
    pair_ids = []
    reductions = []
    ratios = []
    summaries = []
    invalid = 0
    partial = 0
    test["pairs"].reject { |pair| excluded.include?(pair["pair_id"]) }.each do |pair|
      exact!(pair, %w[baseline candidate pair_id], "accounting_pair")
      pair_ids << pair["pair_id"]
      unless pair["pair_id"].is_a?(String)
        invalid += 1
        next
      end
      unless pair["baseline"].is_a?(Hash) && pair["candidate"].is_a?(Hash) && pair["baseline"]["complete"] == true && pair["candidate"]["complete"] == true
        partial += 1
        next
      end
      baseline, baseline_ids = workflow_summary(pair["baseline"])
      candidate, candidate_ids = workflow_summary(pair["candidate"])
      if (baseline_ids + candidate_ids).uniq.length != baseline_ids.length + candidate_ids.length || baseline["total_tokens"] <= 0
        invalid += 1
        next
      end
      reduction = Rational(baseline["total_tokens"] - candidate["total_tokens"], baseline["total_tokens"])
      ratio = Rational(candidate["monotonic_latency_ns"], baseline["monotonic_latency_ns"])
      reductions << reduction
      ratios << ratio
      summaries << {"baseline" => baseline, "candidate" => candidate, "latency_ratio" => ratio.to_s, "pair_id" => pair["pair_id"], "token_reduction" => reduction.to_s}
    end
    invalid += pair_ids.length - pair_ids.uniq.length
    details["excluded_pair_ids"] = excluded.sort
    details["exclusion_count"] = excluded.length
    details["harness_overhead"] = "excluded_from_measurement"
    details["invalid_pair_count"] = invalid
    details["pair_summaries"] = summaries
    details["partial_pair_count"] = partial
    details["valid_pair_count"] = reductions.length
    return ["held_accounting_invalid_pair", details] if invalid.positive?
    return ["held_accounting_partial_pair", details] if partial.positive?
    return ["held_accounting_underpowered", details] if reductions.length < 10
    order = rank(reductions.length)
    token_lower = reductions.sort.fetch(order - 1)
    latency_upper = ratios.sort.fetch(ratios.length - order)
    details["aggregate_absolute"] = {
      "baseline_cached_input" => summaries.sum { |pair| pair["baseline"]["cached_input"] },
      "baseline_direct_input" => summaries.sum { |pair| pair["baseline"]["direct_input"] },
      "baseline_output" => summaries.sum { |pair| pair["baseline"]["output"] },
      "baseline_total_tokens" => summaries.sum { |pair| pair["baseline"]["total_tokens"] },
      "candidate_cached_input" => summaries.sum { |pair| pair["candidate"]["cached_input"] },
      "candidate_direct_input" => summaries.sum { |pair| pair["candidate"]["direct_input"] },
      "candidate_output" => summaries.sum { |pair| pair["candidate"]["output"] },
      "candidate_total_tokens" => summaries.sum { |pair| pair["candidate"]["total_tokens"] }
    }
    details["confidence"] = "19/20"
    details["latency_ratio_distribution"] = rational_distribution(ratios)
    details["latency_ratio_upper_bound"] = latency_upper.to_s
    details["order_statistic_rank"] = order
    details["token_reduction_distribution"] = rational_distribution(reductions)
    details["token_reduction_lower_bound"] = token_lower.to_s
    return ["held_token_reduction_below_threshold", details] if token_lower < Rational(1, 5)
    return ["held_latency_ratio_above_threshold", details] if latency_upper > Rational(6, 5)
  end
  [nil, details]
end

def sufficiency_assessment(raw)
  outcomes = {
    "overflow" => "held_positive_sufficiency_overflow",
    "truncation" => "held_positive_sufficiency_truncation",
    "deletion" => "held_positive_sufficiency_deletion",
    "downgrade" => "held_positive_sufficiency_downgrade",
    "lossy_compaction" => "held_positive_sufficiency_lossy"
  }
  tests = fixture_tests(raw, "sufficiency")
  tests.each do |test|
    allowed!(test, %w[declared_delivery_cost negative_control positive_scenario_completed prohibited_behavior retry_bounded state_promotion], "sufficiency")
    prohibited = Array(test["prohibited_behavior"]).find { |name| outcomes.key?(name) }
    return outcomes.fetch(prohibited) if prohibited
    return "held_positive_sufficiency_retry" unless test["retry_bounded"] == true
    return "held_positive_sufficiency_hidden_promotion" if test["state_promotion"] == "qualified"
    return "held_negative_control_not_sufficient" if test["negative_control"] == true
    return "held_positive_sufficiency_overflow" unless test["positive_scenario_completed"] == true && test["declared_delivery_cost"] == true && test["state_promotion"] == "fixture_only"
  end
  tests.empty? ? nil : "fixture_only_sufficiency_predicate_passed"
end

def qualification_bundle(root)
  records = QUALIFICATION_PREREQUISITES.transform_values do |locators|
    locators.to_h { |locator| [locator, "sha256:#{Digest::SHA256.file(path!(root, locator)).hexdigest}"] }
  end
  [ident(records, "none"), records]
end

def expected_qualification_bindings(root)
  trust = default_doc(root, "#{ROOT_FIX}/collector-trust.yml")
  attestation = default_doc(root, "#{ROOT_FIX}/attestation-valid.json")
  policy = default_doc(root, "#{ROOT_FIX}/policy-valid.yml")
  corpus = default_doc(root, "#{ROOT_FIX}/corpus-valid.json")
  map = default_doc(root, "plugins/traceweaver-core/references/model-context-map.yml")
  oracle = JSON.parse(File.binread(path!(root, "plugins/traceweaver-core/references/model-context-oracle-adequacy-review.json")))
  primitive!(oracle)
  profile = default_doc(root, ".traceweaver/v050-model-governance-workflow-profile.yml")
  bundle_identity, = qualification_bundle(root)
  collector = trust.fetch("collectors").fetch(0)
  {
    "budget_delivery_identity" => "sha256:#{Digest::SHA256.hexdigest("fixture-budget-delivery-B1-direct")}",
    "capability_identity" => "sha256:#{Digest::SHA256.hexdigest(profile.dig("model_context", "capability_snapshot"))}",
    "candidate_definition_identity" => policy.dig("cell", "candidate_definition_identity"),
    "collector_id" => collector["collector_id"],
    "collector_key_spki_sha256" => collector["public_key_spki_sha256"],
    "control_definition_identity" => policy.dig("cell", "control_definition_identity"),
    "corpus_identity" => corpus["corpus_identity"],
    "map_identity" => map["map_digest"],
    "measurement_attestation_identity" => ident(attestation, "signature"),
    "method_suite" => policy["method_suite"],
    "policy_identity" => policy["policy_identity"],
    "profile_identity" => profile["profile_hash"],
    "prerequisite_bundle_identity" => bundle_identity,
    "risk_effort" => "xhigh",
    "route_identity" => policy.dig("cell", "route_identity"),
    "sec_identity" => profile.dig("model_context", "v1_native_child_contract_identity"),
    "served_model_identity" => attestation.dig("execution", "served_model_identity"),
    "signature_suite" => collector["signature_suite"],
    "source_oracle_identity" => oracle["oracle_digest"],
    "tokenizer_identity" => "sha256:#{Digest::SHA256.hexdigest(profile.dig("model_context", "tokenizer_snapshot"))}",
    "trust_registry_digest" => "sha256:#{Digest::SHA256.file(path!(root, "#{ROOT_FIX}/collector-trust.yml")).hexdigest}",
    "trust_root_id" => trust["trust_root_id"],
    "verification_identity" => "sha256:#{Digest::SHA256.hexdigest("VER-TW-093-fixture-prerequisites")}"
  }
end

def prerequisite_outcomes(root)
  QUALIFICATION_PREREQUISITES.transform_values do |locators|
    records = locators.flat_map { |locator| records_for(root, locator).first }
    derive_with_statistics(root, records).first
  end
end

def qualification_assessment(root, materialized)
  tests = fixture_tests(materialized, "qualification")
  tests.each do |test|
    allowed!(test, %w[bindings cell_identity claim_boundary claim_hold_assertion evidence_transfer expired observed_bindings structural_current validation_identity verification_current], "qualification")
    return ["held_exact_cell_evidence_nontransferable", {}] unless test["evidence_transfer"] == "exact_cell"
    return ["held_exact_cell_validation_missing", {}] unless digest?(test["validation_identity"])
    return ["structurally_eligible_reset", {}] if test["expired"] == true || test["structural_current"] != true
    exact!(test["bindings"], QUALIFICATION_BINDING_FIELDS, "qualification")
    exact!(test["observed_bindings"], QUALIFICATION_BINDING_FIELDS, "qualification")
    expected = expected_qualification_bindings(root)
    cell_payload = {"bindings" => test["bindings"], "validation_identity" => test["validation_identity"]}
    return ["structurally_eligible_reset", {}] unless test["bindings"] == expected && test["observed_bindings"] == test["bindings"] && test["cell_identity"] == ident(cell_payload, "none")
    return ["held_claim_boundary_preserved", {}] if test["claim_hold_assertion"] == true
    return ["held_exact_cell_validation_missing", {}] unless test["verification_current"] == true && test["claim_boundary"] == "held"
    required = {
      "attestation" => "fixture_predicate_passed",
      "policy" => "fixture_predicate_passed",
      "quality" => "fixture_predicate_passed",
      "accounting" => "fixture_predicate_passed",
      "sufficiency" => "fixture_only_sufficiency_predicate_passed"
    }
    return ["held_exact_cell_validation_missing", {}] unless prerequisite_outcomes(root) == required
    bundle_identity, = qualification_bundle(root)
    return ["fixture_qualification_predicate_passed", {"prerequisite_bundle_identity" => bundle_identity}]
  end
  [tests.empty? ? nil : "fixture_qualification_predicate_passed", {}]
end

def derive_with_statistics(root, records)
  return ["held_attestation_noncanonical", {}] if records.any? { |_record, noncanonical| noncanonical }
  raw = records.map(&:first)
  raw.each { |record| validate_record!(record) }
  policy, corpus = validate_policy_contract!(root, raw)
  attestation_outcome, attestation_details = attestation_assessment(root, records)
  pair_outcome = pair_assessment(root, raw, policy, corpus)
  quality_outcome, quality_details = quality_assessment(raw)
  accounting_outcome, accounting_details = accounting_assessment(raw)
  sufficiency_outcome = sufficiency_assessment(raw)
  materialized = materialize(root, records).map(&:first)
  qualification_outcome, qualification_details = qualification_assessment(root, materialized)
  outcome = attestation_outcome || pair_outcome || quality_outcome || accounting_outcome || sufficiency_outcome || qualification_outcome || "fixture_predicate_passed"
  statistics = {}
  statistics.merge!(attestation_details)
  statistics["accounting"] = accounting_details unless accounting_details.empty?
  statistics["qualification"] = qualification_details unless qualification_details.empty?
  statistics["quality"] = quality_details unless quality_details.empty?
  [outcome, statistics]
end

def derive(root, records)
  derive_with_statistics(root, records).first
end

def expected_statistics(root, records, _outcome)
  derive_with_statistics(root, records).last
end
options = {}
OptionParser.new do |parser|
  parser.on("--root ROOT") { |value| options[:root] = value }
  parser.on("--case ID") { |value| options[:case] = value }
  parser.on("--fixtures LIST") { |value| options[:fixtures] = value }
  parser.on("--evidence PATH") { |value| options[:evidence] = value }
end.parse!
raise VError, "args" unless options.keys.sort == %i[case evidence fixtures root] && ARGV.empty?
raise VError, "root" if File.symlink?(options[:root])
root = File.realpath(options[:root])
raise VError, "root" unless File.directory?(root)

canonical_reference_path = path!(root, REF)
mirror_reference_path = path!(root, MIRROR)
raise VError, "reference_mirror" unless File.binread(canonical_reference_path) == File.binread(mirror_reference_path)
reference = YAML.safe_load(File.binread(canonical_reference_path), permitted_classes: [], aliases: false)
primitive!(reference)
exact!(reference, %w[acceptance_test_id artifact_id canonical_identity evidence_envelope evidence_templates fixture_inventory fixture_only_positive_outcomes held_claims method_suite network_forbidden offline_only policy provider_calls_forbidden reference_identity schema_version strict_input_rules trust], "reference")
raise VError, "reference" unless reference["schema_version"] == "tw-metric-routing-harness/1" && reference["reference_identity"] == ident(reference, "reference_identity")
raise VError, "reference" unless reference["offline_only"] == true && reference["network_forbidden"] == true && reference["provider_calls_forbidden"] == true && reference["fixture_only_positive_outcomes"] == true
raise VError, "reference" unless reference["method_suite"] == "tw-metric-exact-paired/1" && reference["held_claims"] == HELD
validate_evidence_templates!(root, reference["evidence_templates"])
exact!(reference["fixture_inventory"], %w[entries schema_version], "inventory")
raise VError, "inventory" unless reference["fixture_inventory"]["schema_version"] == "tw-metric-routing-fixture-inventory/1" && reference["fixture_inventory"]["entries"].is_a?(Array)
inventory = reference["fixture_inventory"]["entries"].each_with_object({}) do |entry, result|
  exact!(entry, %w[locator sha256], "inventory_entry")
  raise VError, "inventory_entry" unless entry["locator"].is_a?(String) && entry["sha256"].match?(/\Asha256:[0-9a-f]{64}\z/) && !result.key?(entry["locator"])
  result[entry["locator"]] = entry["sha256"]
end

evidence_path = File.realpath(options[:evidence])
temporary_root = File.realpath(Dir.tmpdir)
raise VError, "evidence" unless evidence_path.start_with?("#{temporary_root}/") && !File.symlink?(evidence_path) && File.file?(evidence_path) && File.size(evidence_path) <= MAX
evidence, noncanonical = json!(File.binread(evidence_path))
exact!(evidence, %w[case_id decision_evidence evidence_identity held_claims outcome schema_version], "evidence")
raise VError, "evidence" if noncanonical || evidence["schema_version"] != "tw-metric-routing-evaluator-evidence/1" || evidence["case_id"] != options[:case] || evidence["evidence_identity"] != ident(evidence, "evidence_identity") || evidence["held_claims"] != HELD
decision = evidence["decision_evidence"]
exact!(decision, %w[fixture_digests fixture_only method_suite reference_identity statistics], "decision_evidence")

records = []
fixture_digests = {}
locators = options[:fixtures].split(",")
raise VError, "fixtures" if locators.empty? || locators.any?(&:empty?) || locators.uniq.length != locators.length
locators.each do |locator|
  values, digest = records_for(root, locator)
  raise VError, "fixture_inventory" unless inventory[locator] == digest
  records.concat(values)
  fixture_digests[locator] = digest
end
outcome = derive(root, records)
statistics = expected_statistics(root, records, outcome)
raise VError, "outcome expected=#{evidence['outcome']} actual=#{outcome}" unless evidence["outcome"] == outcome
raise VError, "decision_evidence" unless decision["fixture_digests"] == fixture_digests && decision["fixture_only"] == true && decision["method_suite"] == reference["method_suite"] && decision["reference_identity"] == reference["reference_identity"] && decision["statistics"] == statistics

validation = {
  "case_id" => options[:case],
  "derived_evidence" => {
    "fixture_digests" => fixture_digests,
    "fixture_only" => true,
    "method_suite" => reference["method_suite"],
    "reference_identity" => reference["reference_identity"],
    "statistics" => statistics
  },
  "evaluator_evidence_identity" => evidence["evidence_identity"],
  "evaluator_evidence_sha256" => "sha256:#{Digest::SHA256.file(evidence_path).hexdigest}",
  "held_claims" => HELD,
  "outcome" => outcome,
  "schema_version" => "tw-metric-routing-validator-evidence/1"
}
validation["validation_identity"] = ident(validation, "validation_identity")
$stdout.write(JSON.generate(canon(validation)))
