#!/usr/bin/env bash
# TRACEWEAVER: file-role=advisory-pretooluse-tdd-gate; req=REQ-TW-080; trace=TRACE-TW-061; ver=VER-TW-081
# TRACEWEAVER: verifies=VER-TW-081; req=REQ-TW-080; trace=TRACE-TW-061
# Blocking is a held claim (REQ-TW-080): this hook always exits 0.

set -u

input="$(cat 2>/dev/null || true)"

json_string() {
  local key="$1"
  printf '%s' "$input" | sed -nE "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"([^\"]*)\".*/\1/p" | head -n 1
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

emit_warning() {
  local target="$1"
  local context="TraceWeaver advisory: ${target} is behavior-bearing but no linked, review-passed V&V definition and RED evidence were found. Run plan -> tw-vv-define -> tw-work; blocking/enforcing remains held."
  local escaped
  escaped="$(json_escape "$context")"
  if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
    printf '{"additional_context":"%s"}\n' "$escaped"
  elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"%s"}}\n' "$escaped"
  else
    printf '{"additionalContext":"%s"}\n' "$escaped"
  fi
}

is_behavior_bearing() {
  local root="$1"
  local path="$2"
  local candidate
  case "$path" in
    docs/*|fixtures/*|traceability-matrix.md|*.md) return 1 ;;
    plugins/*/hooks/*|*/plugins/*/hooks/*|*/scripts/*|scripts/*|*/skills/*|skills/*|*.sh|*.bash|*.py|*.rb|*.js|*.jsx|*.ts|*.tsx|*.go|*.rs|*.java|*.kt|*.c|*.cc|*.cpp|*.h|*.hpp) return 0 ;;
    *)
      candidate="$path"
      [[ "$candidate" == /* ]] || candidate="$root/$candidate"
      [[ -f "$candidate" && -x "$candidate" ]]
      ;;
  esac
}

has_reviewed_capsule=0
has_reviewed_definition=0
has_red_evidence=0

matched_capsule_definition() {
  local capsule="$1"
  local target="$2"
  python3 - "$capsule" "$target" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        capsule = json.load(source)
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)

def contains(value, expected):
    if isinstance(value, str):
        return value == expected
    if isinstance(value, dict):
        return any(contains(item, expected) for item in value.values())
    if isinstance(value, list):
        return any(contains(item, expected) for item in value)
    return False

if capsule.get("review_status") != "review_passed" or not contains(capsule, sys.argv[2]):
    raise SystemExit(1)

vv_definition = capsule.get("vv_definition")
if not isinstance(vv_definition, str) or not vv_definition:
    raise SystemExit(1)
print(vv_definition)
PY
}

reviewed_definition_red_evidence_state() {
  local definition="$1"
  local root="$2"
  local target="$3"
  python3 - "$definition" "$root" "$target" <<'PY'
import json
import os
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        definition = json.load(source)
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)

def contains(value, expected):
    if isinstance(value, str):
        return value == expected
    if isinstance(value, dict):
        return any(contains(item, expected) for item in value.values())
    if isinstance(value, list):
        return any(contains(item, expected) for item in value)
    return False

if definition.get("review_status") != "review_passed" or not contains(definition, sys.argv[3]):
    raise SystemExit(1)

red_evidence = definition.get("red_evidence")
paths = [red_evidence] if isinstance(red_evidence, str) else red_evidence
if not isinstance(paths, list) or not paths or not all(isinstance(path, str) and path for path in paths):
    print("invalid")
    raise SystemExit(0)

root = sys.argv[2]
for path in paths:
    resolved = path if os.path.isabs(path) else os.path.join(root, path)
    if not os.path.isfile(resolved) or os.path.getsize(resolved) == 0:
        print("invalid")
        raise SystemExit(0)

print("valid")
PY
}

schema_v1_capsule_has_evidence() {
  local capsule="$1"
  local root="$2"
  python3 - "$capsule" "$root" <<'PY'
import json
import os
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        capsule = json.load(source)
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)

root = os.path.abspath(sys.argv[2])
verification_fields = (
    "trace_id", "ver_id", "val_id", "verification_artifact",
    "red_evidence", "validation_artifact",
)

def present_string(value):
    return isinstance(value, str) and bool(value.strip())

def path_escapes_root(raw_path):
    if os.path.isabs(raw_path):
        return True
    resolved = os.path.normpath(os.path.join(root, raw_path))
    try:
        return os.path.commonpath((root, resolved)) != root
    except ValueError:
        return True

def nonempty_red_evidence(raw_path):
    if not present_string(raw_path) or path_escapes_root(raw_path):
        return False
    resolved = os.path.normpath(os.path.join(root, raw_path))
    return os.path.isfile(resolved) and os.path.getsize(resolved) > 0

if not isinstance(capsule, dict) or capsule.get("schema_version") != "tw-vv-capsule/1":
    raise SystemExit(1)

requirements = capsule.get("requirements")
if not isinstance(requirements, list) or not requirements:
    raise SystemExit(1)

for requirement in requirements:
    if not isinstance(requirement, dict):
        raise SystemExit(1)

    is_verification_mode = any(present_string(requirement.get(field)) for field in verification_fields)
    if not is_verification_mode:
        if "not_applicable" in requirement:
            continue
        raise SystemExit(1)

    reviews = requirement.get("reviews")
    if not isinstance(reviews, list) or not any(
        isinstance(review, dict) and review.get("status") == "passed"
        for review in reviews
    ):
        raise SystemExit(1)

    if not nonempty_red_evidence(requirement.get("red_evidence")):
        raise SystemExit(1)
PY
}

check_evidence() {
  local root="$1"
  local target="$2"
  local capsule definition_path definition state
  if [[ -d "$root/.traceweaver/task-capsules" ]]; then
    while IFS= read -r -d '' capsule; do
      if definition_path="$(matched_capsule_definition "$capsule" "$target")"; then
        has_reviewed_capsule=1
        definition="$definition_path"
        [[ "$definition" == /* ]] || definition="$root/$definition"
        if state="$(reviewed_definition_red_evidence_state "$definition" "$root" "$target")"; then
          has_reviewed_definition=1
          [[ "$state" == "valid" ]] && has_red_evidence=1
        fi
      fi
    done < <(find "$root/.traceweaver/task-capsules" -type f -name '*.json' -print0 2>/dev/null)
  fi

  # The root search includes .traceweaver/ and docs/validation/ as well as
  # any other repository location that may hold a tw-vv-capsule/1 artifact.
  while IFS= read -r -d '' capsule; do
    if schema_v1_capsule_has_evidence "$capsule" "$root"; then
      has_reviewed_capsule=1
      has_reviewed_definition=1
      has_red_evidence=1
      return
    fi
  done < <(find "$root" -type f -name '*.json' ! -path "$root/.git/*" -print0 2>/dev/null)
}

# Claude/Cursor-style payloads expose these keys. This intentionally fails
# open for unknown input because alpha is advisory-only.
tool_name="$(json_string tool_name)"
target="$(json_string file_path)"
[[ -n "$target" ]] || target="$(json_string path)"
root="$(json_string cwd)"
[[ -n "$root" && -d "$root" ]] || root="${PWD:-.}"

if [[ "$tool_name" == "Write" || "$tool_name" == "Edit" ]] && [[ -n "$target" ]] && is_behavior_bearing "$root" "$target"; then
  check_evidence "$root" "$target"
  if [[ "$has_reviewed_capsule" -ne 1 || "$has_reviewed_definition" -ne 1 || "$has_red_evidence" -ne 1 ]]; then
    emit_warning "$target"
    exit 0
  fi
fi

printf '{}\n'
exit 0
