{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tw-lifecycle-acceptance-hub/1",
  "title": "TraceWeaver lifecycle acceptance hub manifest",
  "description": "Content-addressed offline hub binding one current lifecycle graph, strict projection, evidence receipt, named-baseline acceptance pack, record index, and every output file without creating authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "profile", "authority_role",
    "controlling_sources", "baseline", "graph_id", "projection",
    "evidence", "acceptance_pack", "record_index", "files",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "tw-lifecycle-acceptance-hub/1"},
    "manifest_id": {"$ref": "#/$defs/digest"},
    "profile": {"const": "strict_static_accessible_offline_printable"},
    "authority_role": {"const": "derived_non_authoritative"},
    "controlling_sources": {"const": "registered_markdown_yaml_and_external_receipts"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "graph_id": {"$ref": "#/$defs/digest"},
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "digest"],
      "properties": {"manifest_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "digest", "evidence_links", "review_links"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"},
        "evidence_links": {"type": "array"}, "review_links": {"type": "array"}
      }
    },
    "acceptance_pack": {
      "type": "object", "additionalProperties": false,
      "required": ["pack_id", "digest", "acceptance_state", "owner_disposition", "truth_stage_states", "remaining_holds"],
      "properties": {
        "pack_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"},
        "acceptance_state": {"enum": ["held", "accepted"]}, "owner_disposition": {"type": "object"},
        "truth_stage_states": {"type": "object"},
        "remaining_holds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "record_index": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["record_id", "record_type", "title", "owner", "freshness", "acceptance_state", "record_digest", "locator"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1}, "record_type": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
          "freshness": {"type": "string", "minLength": 1}, "acceptance_state": {"type": "string", "minLength": 1},
          "record_digest": {"$ref": "#/$defs/digest"}, "locator": {"type": "string", "pattern": "^projection/lifecycle\\.html#[A-Z]"}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "digest", "bytes", "media_type"],
        "properties": {
          "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"},
          "bytes": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "generation", "digest"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "generation": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
