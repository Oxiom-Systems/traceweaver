{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tw-lifecycle-record/1",
  "title": "TraceWeaver federated lifecycle record",
  "description": "Provider-independent lifecycle envelope. Imported, inferred, evidence, and derived records remain non-authoritative until a named human accepts a controlled delta in its owning authority source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_type", "title", "owner",
    "authority_class", "source", "applicability", "baseline", "freshness",
    "acceptance_state", "relationships", "fields"
  ],
  "properties": {
    "schema_version": {"const": "tw-lifecycle-record/1"},
    "record_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "record_type": {
      "enum": [
        "commitment", "intent", "need", "requirement", "constraint",
        "decision", "interface", "risk", "change", "product_artifact",
        "verification_definition", "verification_result",
        "validation_definition", "validation_result", "acceptance_decision",
        "baseline", "evidence"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "authority_class": {
      "enum": ["authoritative", "candidate", "imported_candidate", "external_reference", "evidence", "derived"]
    },
    "source": {"$ref": "#/$defs/source"},
    "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
    "baseline": {"$ref": "#/$defs/baseline"},
    "freshness": {"enum": ["current", "stale", "held", "unknown"]},
    "acceptance_state": {
      "enum": ["proposed", "prepared", "observed_not_accepted", "accepted", "rejected", "held", "superseded"]
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "fields": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"acceptance_state": {"const": "accepted"}}, "required": ["acceptance_state"]},
      "then": {
        "required": ["acceptance"],
        "properties": {"authority_class": {"const": "authoritative"}}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "version", "digest", "role", "provenance"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{2,126}$"},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "role": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "receipt_id": {"$ref": "#/$defs/digest"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "generation", "digest"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "generation": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "accepted_by", "accepted_at", "authority_source_id"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "accepted_by": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time"},
        "authority_source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{2,126}$"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "target_id", "relationship_type", "applicable", "provenance"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "target_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "relationship_type": {
          "enum": [
            "derived_from", "refines", "satisfies", "allocated_to",
            "constrained_by", "decided_by", "exposes_interface", "mitigates",
            "changes", "impacts", "implemented_by", "verified_by",
            "validated_by", "accepted_by", "baselines", "evidences",
            "supersedes", "duplicates_candidate", "depends_on", "invalidates",
            "reverified_by"
          ]
        },
        "applicable": {"type": "boolean"},
        "provenance": {"type": "string", "minLength": 1}
      }
    }
  }
}
