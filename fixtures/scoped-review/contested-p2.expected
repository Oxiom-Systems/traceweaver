profile: L2
review_identity:
  semantic_authority_digest: sha256:semantic-authority-contested-p2
  behavior_digest: sha256:behavior-contested-p2
  verification_digest: sha256:verification-contested-p2
  policy_epoch: tw-review-policy/2026-08-21
audit_metadata:
  requirements_baseline_hash: sha256:requirements-contested-p2
  workflow_profile_hash: sha256:profile-contested-p2
  frozen_scope_identity: sha256:scope-contested-p2
bookkeeping:
  bookkeeping_digest: sha256:bookkeeping-contested-p2
fanout:
  active_reviewers: [independent]
  personas: [routine_independent]
  specialist_triggered: false
  validator_triggered: false
finding:
  severity: P2
  disputed: true
  route: contested_p2_decision_path
repair_cycles: 0
terminal_receipt:
  facts:
    implemented: { state: passed, evidence_refs: [implementation-contested-p2] }
    verified: { state: passed, evidence_refs: [verification-contested-p2] }
    reviewed: { state: passed, evidence_refs: [review-contested-p2] }
    deployed: { state: not_applicable, evidence_refs: [] }
    dogfooded: { state: not_applicable, evidence_refs: [] }
  requirements: { deploy_required: false, chrome_dogfood_required: false }
  terminal_state: complete
  accounting: { process_minutes: 1, delivery_minutes: 8 }
