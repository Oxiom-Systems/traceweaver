profile: L3
review_identity:
  semantic_authority_digest: sha256:semantic-authority-l3
  behavior_digest: sha256:behavior-l3
  verification_digest: sha256:verification-l3
  policy_epoch: tw-review-policy/2026-08-21
audit_metadata:
  requirements_baseline_hash: sha256:requirements-l3
  workflow_profile_hash: sha256:profile-l3
  frozen_scope_identity: sha256:scope-l3
bookkeeping:
  bookkeeping_digest: sha256:bookkeeping-l3
fanout:
  active_reviewers: [independent]
  personas: [routine_independent]
  specialist_triggered: false
  validator_triggered: false
finding:
  severity: P0
  route: repair_then_rerun_scoped_review
repair_cycles: 1
terminal_receipt:
  facts:
    implemented: { state: passed, evidence_refs: [implementation-l3] }
    verified: { state: passed, evidence_refs: [verification-l3] }
    reviewed: { state: passed, evidence_refs: [review-l3] }
    deployed: { state: passed, evidence_refs: [deploy-l3] }
    dogfooded: { state: held, evidence_refs: [] }
  requirements: { deploy_required: true, chrome_dogfood_required: true }
  terminal_state: held_dogfood
  accounting: { process_minutes: 3, delivery_minutes: 16 }
