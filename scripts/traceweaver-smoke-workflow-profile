#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=workflow-profile-convergence-smoke; req=REQ-TW-037,REQ-TW-056,REQ-TW-057,REQ-TW-109,REQ-TW-114; trace=TRACE-TW-067,TRACE-TW-072; ver=VER-TW-087,VER-TW-092
# TRACEWEAVER: verifies=VER-TW-087,VER-TW-092; req=REQ-TW-037,REQ-TW-056,REQ-TW-057,REQ-TW-109,REQ-TW-114; trace=TRACE-TW-067,TRACE-TW-072

root="$(cd "$(dirname "$0")/.." && pwd)"

ruby - "$root" <<'RUBY'
require "yaml"

root = ARGV.fetch(0)
fixtures = File.join(root, "fixtures/workflow-profile")

def load_yaml(path)
  YAML.safe_load(File.read(path), permitted_classes: [], aliases: false)
end

def require_field(value, field, source)
  raise "#{source}: missing #{field}" if value.nil? || value == "" || value == [] || value == {}
end

canonical_template_path = File.join(root, "plugins/traceweaver-core/references/workflow-profile-template.yml")
packaged_template_path = File.join(root, "plugins/traceweaver-core/skills/tw-auto/references/workflow-profile-template.yml")
raise "workflow-profile-template: packaged mirror drift" unless File.binread(canonical_template_path) == File.binread(packaged_template_path)
template = load_yaml(canonical_template_path)
%w[schema_version task_id profile_revision profile_status risk selection_rationale model_routing model_context selected_controls child_roles model_selection reviewer_cap repair_cycle_cap severe_blocker_exception_cycle_cap requires_deploy requires_chrome_dogfood profile_hash immutable_after_building accounting].each do |field|
  raise "workflow-profile-template: missing #{field}" unless template.key?(field)
end
raise "workflow-profile-template: wrong schema" unless template.fetch("schema_version") == "tw-workflow-profile/1"
model_routing = template.fetch("model_routing")
raise "workflow-profile-template: main model drift" unless model_routing.fetch("codex_main_model") == "gpt-5.6-sol"
raise "workflow-profile-template: child model drift" unless model_routing.fetch("codex_subagent_model") == "gpt-5.6-terra"
raise "workflow-profile-template: Sol child allowed" unless model_routing.fetch("sol_allowed_for_subagents") == false
raise "workflow-profile-template: effort map drift" unless model_routing.fetch("risk_reasoning_effort") == {"L0" => "low", "L1" => "medium", "L2" => "high", "L3" => "xhigh"}
model_context = template.fetch("model_context")
raise "workflow-profile-template: model-context schema drift" unless model_context.fetch("schema_version") == "tw-model-context-profile/1"
raise "workflow-profile-template: model-context mode drift" unless model_context.fetch("mode") == "advisory_shadow_compile"
raise "workflow-profile-template: v1 authority boundary drift" unless model_context.fetch("authoritative_runtime") == "v1" && model_context.fetch("active_cutover") == "disabled"
raise "workflow-profile-template: v1 native-child compatibility identity drift" unless model_context.fetch("v1_native_child_contract_identity") == "sha256:578af74a58db59922a133b1af35e4b21ed1a74344c6c3adf66fc8bb665d091b2"
raise "workflow-profile-template: capability hypothesis drift" unless model_context.fetch("capability_context_window") == 272_000
raise "workflow-profile-template: context reserve drift" unless model_context.fetch("host_system_tool_reserve") == 32_000 && model_context.fetch("assembled_input_target") == 224_000 && model_context.fetch("assembled_input_proposal_ceiling") == 240_000
raise "workflow-profile-template: budget selection order drift" unless model_context.fetch("ascending_selection") == %w[B0 B1 B2 B3]
expected_model_context_budgets = {
  "B0" => {"packet_input_cap" => 32_000, "reserved_output_cap" => 4_000},
  "B1" => {"packet_input_cap" => 64_000, "reserved_output_cap" => 8_000},
  "B2" => {"packet_input_cap" => 128_000, "reserved_output_cap" => 16_000},
  "B3" => {"packet_input_cap" => 192_000, "reserved_output_cap" => 24_000}
}
raise "workflow-profile-template: model-context budget drift" unless model_context.fetch("budgets") == expected_model_context_budgets
source_oracle = model_context.fetch("source_oracle")
expected_source_categories = %w[controlling_authority task_scope skill_contract implementation_dependencies current_external_sources accepted_evidence]
raise "workflow-profile-template: source-category taxonomy drift" unless source_oracle.fetch("categories") == expected_source_categories
raise "workflow-profile-template: mandatory source-category drift" unless source_oracle.fetch("mandatory_all_routes") == expected_source_categories.first(3)
raise "workflow-profile-template: model-context efficiency overclaim" unless model_context.fetch("efficiency_eligibility") == false
raise "workflow-profile-template: missing immutable building boundary" unless template.dig("immutable_after_building", "fields").include?("profile_hash")
raise "workflow-profile-template: model-context profile not immutable after building" unless template.dig("immutable_after_building", "fields").include?("model_context")
raise "workflow-profile-template: missing fixed accounting categories" unless template.dig("accounting", "fixed_categories") == %w[process delivery unclassified]
profile_budget = template.fetch("process_budget")
%w[target_total_effort_percent hard_ceiling_total_effort_percent target_process_to_delivery_ratio_percent hard_ceiling_process_to_delivery_ratio_percent estimated_delivery_minutes estimated_process_target_minutes estimated_process_ceiling_minutes].each do |field|
  raise "workflow-profile-template: missing process_budget.#{field}" unless profile_budget.key?(field)
end
raise "workflow-profile-template: target representations differ" unless profile_budget.fetch("target_total_effort_percent") == (100.0 * profile_budget.fetch("target_process_to_delivery_ratio_percent") / (100 + profile_budget.fetch("target_process_to_delivery_ratio_percent"))).round
raise "workflow-profile-template: ceiling representations differ" unless profile_budget.fetch("hard_ceiling_total_effort_percent") == (100.0 * profile_budget.fetch("hard_ceiling_process_to_delivery_ratio_percent") / (100 + profile_budget.fetch("hard_ceiling_process_to_delivery_ratio_percent"))).round

expected = {
  "l0-profile.yml" => { risk: "L0", cap: 0, repair: 0, severe: 0, deploy: false, dogfood: false },
  "l1-profile.yml" => { risk: "L1", cap: 1, repair: 1, severe: 1, deploy: false, dogfood: false },
  "l2-profile.yml" => { risk: "L2", cap: 1, repair: 1, severe: 1, deploy: true, dogfood: false },
  "l3-profile.yml" => { risk: "L3", cap: 1, repair: 1, severe: 1, deploy: true, dogfood: true }
}

expected.each do |name, rule|
  item = load_yaml(File.join(fixtures, name))
  raise "#{name}: non-deterministic profile" unless item.fetch("risk") == rule[:risk] && item.fetch("expected_profile") == rule[:risk]
  %w[selection_rationale selected_controls child_roles model_selection profile_hash].each { |field| require_field(item[field], field, name) }
  %w[availability choice rationale].each { |field| require_field(item.fetch("model_selection")[field], field, name) }
  raise "#{name}: non-Terra model choice" unless item.dig("model_selection", "choice") == "gpt-5.6-terra"
  item.fetch("child_roles").each do |role, route|
    raise "#{name}: #{role} child is not explicit Terra" unless route.fetch("model") == "gpt-5.6-terra"
    raise "#{name}: #{role} effort drift" unless route.fetch("reasoning_effort") == model_routing.fetch("risk_reasoning_effort").fetch(rule[:risk])
  end
  raise "#{name}: reviewer cap" unless item.fetch("reviewer_cap") == rule[:cap]
  raise "#{name}: repair cap" unless item.fetch("repair_cycle_cap") == rule[:repair]
  raise "#{name}: severe exception cap" unless item.fetch("severe_blocker_exception_cycle_cap") == rule[:severe]
  raise "#{name}: deploy requirement" unless item.fetch("requires_deploy") == rule[:deploy]
  raise "#{name}: dogfood requirement" unless item.fetch("requires_chrome_dogfood") == rule[:dogfood]
end

expansion = load_yaml(File.join(fixtures, "profile-expansion-after-start.expected"))
raise "expansion: started profile not frozen" unless expansion.dig("initial", "profile_status") == "building"
raise "expansion: silent expansion accepted" unless expansion.dig("attempted_silent_expansion", "result") == "refused_profile_immutable"
raise "expansion: new revision missing" unless expansion.dig("escalated_revision", "profile_revision") > expansion.dig("initial", "profile_revision")
raise "expansion: reason missing" if expansion.dig("escalated_revision", "escalation_reason").to_s.empty?

budget = load_yaml(File.join(fixtures, "process-budget-boundaries.expected"))
raise "budget: target total-effort representation wrong" unless budget.fetch("target_total_effort_percent") == (100.0 * budget.fetch("target_process_to_delivery_ratio_percent") / (100 + budget.fetch("target_process_to_delivery_ratio_percent"))).round
raise "budget: ceiling total-effort representation wrong" unless budget.fetch("hard_ceiling_total_effort_percent") == (100.0 * budget.fetch("hard_ceiling_process_to_delivery_ratio_percent") / (100 + budget.fetch("hard_ceiling_process_to_delivery_ratio_percent"))).round
raise "budget: target policy differs from profile template" unless budget.fetch("target_total_effort_percent") == profile_budget.fetch("target_total_effort_percent") && budget.fetch("target_process_to_delivery_ratio_percent") == profile_budget.fetch("target_process_to_delivery_ratio_percent")
raise "budget: ceiling policy differs from profile template" unless budget.fetch("hard_ceiling_total_effort_percent") == profile_budget.fetch("hard_ceiling_total_effort_percent") && budget.fetch("hard_ceiling_process_to_delivery_ratio_percent") == profile_budget.fetch("hard_ceiling_process_to_delivery_ratio_percent")
raise "budget: target guard wrong" unless budget.fetch("estimated_process_target_minutes") == budget.fetch("target_process_to_delivery_ratio_percent") / 100.0 * budget.fetch("estimated_delivery_minutes")
raise "budget: ceiling guard wrong" unless budget.fetch("estimated_process_ceiling_minutes") == budget.fetch("hard_ceiling_process_to_delivery_ratio_percent") / 100.0 * budget.fetch("estimated_delivery_minutes")
times = budget.fetch("receipts").map { |receipt| receipt.fetch("monotonic_elapsed_minutes") }
raise "budget: non-monotonic receipt time" unless times == times.sort
raise "budget: missing dispatch/return accounting" unless budget.fetch("receipts").map { |receipt| receipt.fetch("boundary") }.uniq.sort == %w[dispatch return]
raise "budget: target action wrong" unless budget.dig("receipts", 3, "action") == "stop_optional_artifacts_and_duplicate_review"
raise "budget: full-timebox projection omitted" unless budget.dig("projected_ceiling_breach", "projected_process_minutes") == budget.dig("projected_ceiling_breach", "current_process_minutes") + budget.dig("projected_ceiling_breach", "next_child_maximum_timebox_minutes")
raise "budget: ceiling breach not refused" unless budget.dig("projected_ceiling_breach", "result") == "refused_estimated_process_ceiling"
raise "budget: unclassified not charged as process" unless budget.dig("unclassified_until_resolved", "raw_minutes") == budget.dig("unclassified_until_resolved", "counts_as_process_minutes")
raise "budget: delivery-underrun hold missing" unless budget.dig("delivery_underrun_terminal", "result") == "held_process_budget"
raise "budget: terminal hard hold wrong" unless budget.dig("delivery_underrun_terminal", "actual_process_minutes") > budget.dig("delivery_underrun_terminal", "actual_delivery_minutes")

auto = File.read(File.join(root, "plugins/traceweaver-core/skills/tw-auto/SKILL.md"))
raise "tw-auto: direct implementation route present" unless auto.include?("It has no direct implementation path.")
raise "tw-auto: profile router missing" unless auto.include?("advisory profile and capsule router")
raise "tw-auto: direct coding engine present" if auto.include?("ce-work")
puts "workflow-profile smoke: PASS"
RUBY
