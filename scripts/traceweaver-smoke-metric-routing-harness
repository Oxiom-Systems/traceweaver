#!/usr/bin/env ruby
# frozen_string_literal: true
# TRACEWEAVER: file-role=metric-routing-harness-acceptance-smoke; req=REQ-TW-124,REQ-TW-125,REQ-TW-126,REQ-TW-127,REQ-TW-128,REQ-TW-129; trace=TRACE-TW-073; ver=VER-TW-093
# TRACEWEAVER: verifies=ATP-TW-050; req=REQ-TW-124,REQ-TW-125,REQ-TW-126,REQ-TW-127,REQ-TW-128,REQ-TW-129; trace=TRACE-TW-073; ver=VER-TW-093
#
# Deterministic, offline-only pre-builder contract for ART-TW-080.  Before the
# harness exists this smoke validates the frozen ATP inventory and independent
# statistics oracle, then reports the named implementation groups that are
# intentionally absent.  Once every group exists, it captures each evaluator's
# canonical JSON stdout into a fresh temporary file and gives that immutable
# evidence to the local validator without a shell, provider, network, or
# credential.

