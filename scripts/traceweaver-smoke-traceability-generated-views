#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=traceability-view-smoke; req=REQ-TW-067; trace=TRACE-TW-051; ver=VER-TW-064

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
SCANNER="$ROOT_DIR/plugins/traceweaver-core/skills/tw-traceability-check/scripts/traceweaver-check-code-anchors"

# TRACEWEAVER: verifies=VER-TW-064; req=REQ-TW-067; trace=TRACE-TW-051
"$ROOT_DIR/scripts/traceweaver-generate-traceability-views" --root "$ROOT_DIR" --out "$TMP_DIR" >/dev/null

# JSON-determinism fixture: equivalent legacy/modern empty collections must
# serialize to identical bytes without rewriting string values.
cat > "$TMP_DIR/json-determinism-legacy.json" <<'EOF'
{
  "empty_array": [

  ],
  "empty_object": {

  },
  "nested": {
    "items": [

    ],
    "metadata": {

    }
  },
  "bracket_like_text": "literal [ ] and { } must remain unchanged"
}
EOF
cat > "$TMP_DIR/json-determinism-modern.json" <<'EOF'
{
  "empty_array": [],
  "empty_object": {},
  "nested": {
    "items": [],
    "metadata": {}
  },
  "bracket_like_text": "literal [ ] and { } must remain unchanged"
}
EOF

cp "$ROOT_DIR/docs/generated/traceability-data.json" "$TMP_DIR/traceability-data.before-fixture.json"
if "$ROOT_DIR/scripts/traceweaver-generate-traceability-views" \
  --json-fixture "$TMP_DIR/json-determinism-legacy.json" \
  >"$TMP_DIR/json-fixture-missing-out.log" 2>&1; then
  echo "expected --json-fixture without --out to fail" >&2
  exit 1
fi
grep -q -- "--json-fixture requires --out PATH" "$TMP_DIR/json-fixture-missing-out.log"
cmp "$ROOT_DIR/docs/generated/traceability-data.json" "$TMP_DIR/traceability-data.before-fixture.json"

mkdir "$TMP_DIR/json-determinism-legacy" "$TMP_DIR/json-determinism-modern" "$TMP_DIR/json-determinism-idempotent"
"$ROOT_DIR/scripts/traceweaver-generate-traceability-views" --json-fixture "$TMP_DIR/json-determinism-legacy.json" --out "$TMP_DIR/json-determinism-legacy" >/dev/null
"$ROOT_DIR/scripts/traceweaver-generate-traceability-views" --json-fixture "$TMP_DIR/json-determinism-modern.json" --out "$TMP_DIR/json-determinism-modern" >/dev/null
cmp "$TMP_DIR/json-determinism-legacy/traceability-data.json" "$TMP_DIR/json-determinism-modern/traceability-data.json"
"$ROOT_DIR/scripts/traceweaver-generate-traceability-views" --json-fixture "$TMP_DIR/json-determinism-legacy/traceability-data.json" --out "$TMP_DIR/json-determinism-idempotent" >/dev/null
cmp "$TMP_DIR/json-determinism-legacy/traceability-data.json" "$TMP_DIR/json-determinism-idempotent/traceability-data.json"
ruby -rjson -e '
  legacy = JSON.parse(File.read(ARGV.fetch(0)))
  modern = JSON.parse(File.read(ARGV.fetch(1)))
  output = JSON.parse(File.read(ARGV.fetch(2)))
  abort "fixture semantics changed" unless legacy == modern && modern == output
  abort "bracket-like string changed" unless output.fetch("bracket_like_text") == "literal [ ] and { } must remain unchanged"
' "$TMP_DIR/json-determinism-legacy.json" "$TMP_DIR/json-determinism-modern.json" "$TMP_DIR/json-determinism-legacy/traceability-data.json"

ruby -rjson -e '
  data = JSON.parse(File.read(File.join(ARGV.fetch(0), "traceability-data.json")))
  req_ids = data.fetch("requirements").map { |row| row.fetch("id") }
  abort "REQ-TW-057 missing from generated requirements" unless req_ids.include?("REQ-TW-057")

  coverage = data.fetch("structured_acceptance_coverage")
  abort "structured acceptance coverage count mismatch" unless coverage.length == req_ids.length
  abort "structured acceptance non-closed count missing" unless data.fetch("row_counts").fetch("structured_acceptance_non_closed_requirements") >= data.fetch("row_counts").fetch("structured_acceptance_missing_requirements")
  coverage_by_req = coverage.to_h { |row| [row.fetch("requirement_id"), row] }
  abort "REQ-TW-066 acceptance coverage missing" unless coverage_by_req.fetch("REQ-TW-066").fetch("structured_acceptance_result_ids").any?
  abort "REQ-TW-067 missing acceptance gap" unless coverage_by_req.fetch("REQ-TW-067").fetch("coverage_status") == "missing_structured_acceptance_result"
  abort "REQ-TW-067 missing acceptance next trigger" unless coverage_by_req.fetch("REQ-TW-067").fetch("next_triggers").any?
' "$TMP_DIR"

diff -u "$ROOT_DIR/docs/generated/traceability-dashboard.md" "$TMP_DIR/traceability-dashboard.md"
diff -u "$ROOT_DIR/docs/generated/traceability-data.json" "$TMP_DIR/traceability-data.json"
diff -u "$ROOT_DIR/docs/generated/traceability-graph.mmd" "$TMP_DIR/traceability-graph.mmd"

printf '%s\n' \
  docs/generated/traceability-dashboard.md \
  docs/generated/traceability-data.json \
  docs/generated/traceability-graph.mmd \
  scripts/traceweaver-generate-traceability-views \
  scripts/traceweaver-smoke-traceability-generated-views > "$TMP_DIR/changed-files.txt"
"$SCANNER" --root "$ROOT_DIR" --mode implementation --changed-files "$TMP_DIR/changed-files.txt" >/dev/null

echo "traceability_generated_views_smoke=pass"
echo "traceability_generated_views_compared=traceability-dashboard.md,traceability-data.json,traceability-graph.mmd"
echo "traceability_generated_views_scan=pass"
