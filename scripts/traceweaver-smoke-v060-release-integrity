SCHEMA = "tw-release-readiness/3"
ALGORITHM = "sha256(sorted(path + NUL + git_mode + NUL + sha256(file_bytes) + LF))"
MANIFESTS = {
  ".claude-plugin/marketplace.json" => %w[metadata version],
  "plugins/traceweaver-core/.claude-plugin/plugin.json" => %w[version],
  "plugins/traceweaver-core/.codex-plugin/plugin.json" => %w[version],
