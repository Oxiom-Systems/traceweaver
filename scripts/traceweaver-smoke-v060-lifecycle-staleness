#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=v060-lifecycle-staleness-entrypoint; req=REQ-TW-140; trace=TRACE-TW-074; ver=VER-TW-094
# TRACEWEAVER: verifies=VER-TW-094; req=REQ-TW-140; trace=TRACE-TW-074

