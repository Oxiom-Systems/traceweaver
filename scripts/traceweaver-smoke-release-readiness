check_production_pass() {
  ruby "$production_repo/$checker" \
    --receipt "$production_candidate" \
    --version 0.5.0 \
    --root "$production_repo" \
    --merge-sha "$released_base"
}

refresh_production_digest() {
  local next_digest
  next_digest="$(calculate_production_digest)"
  ruby -e '
    path, old_digest, new_digest = ARGV
    source = File.read(path)
    count = source.scan(old_digest).length
    abort("expected two production digest bindings, got #{count}") unless count == 2
    File.write(path, source.gsub(old_digest, new_digest))
  ' "$production_candidate" "$production_digest" "$next_digest"
  production_digest="$next_digest"
}

expect_production_scope_binding_rejected() {
  local label="$1"
  local missing_path="$2"
  local expected_error="$3"
  local path
  local reduced_scope=()
  for path in "${production_scope[@]}"; do
    [ "$path" = "$missing_path" ] || reduced_scope+=("$path")
  done
  if [ "${#reduced_scope[@]}" -ne "$(( ${#production_scope[@]} - 1 ))" ]; then
    echo "${label}=scope_path_not_found" >&2
    exit 1
  fi
  local reduced_digest
  reduced_digest="$(calculate_paths_digest "${reduced_scope[@]}")"
  local backup="$temp_dir/$label-candidate-good.md"
  cp "$production_candidate" "$backup"
  ruby -e '
    path, missing_path, old_digest, reduced_digest = ARGV
    source = File.read(path)
    scope_line = "      - #{missing_path}\n"
    abort("expected one candidate-scope path") unless source.scan(scope_line).length == 1
    abort("expected two production digest bindings") unless source.scan(old_digest).length == 2
    source = source.sub(scope_line, "").gsub(old_digest, reduced_digest)
    File.write(path, source)
  ' "$production_candidate" "$missing_path" "$production_digest" "$reduced_digest"
  expect_rejected "$label" check_production_pass
  grep -Fq "$expected_error" "$temp_dir/$label.err"
  cp "$backup" "$production_candidate"
}

