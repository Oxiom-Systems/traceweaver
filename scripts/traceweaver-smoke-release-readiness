      experimental_budgets: /B0--B3.*experimental|experimental.*B0--B3/im,
      v1_authoritative: /v1.*authoritative|authoritative.*v1/im,
      separate_receipts: /separate.*receipt|receipt.*separate/im,
      install_rollback: /install.*transaction.*rollback|transactional.*install.*rollback/im,
      active_cutover: /active cutover.*disabled|active-cutover.*disabled/im,
      held_claims: /Active routing, descendant enforcement, served-model attestation, token savings, token sufficiency, quality equivalence, and provider replay qualification remain held\./m
    }
    checks.each { |name, pattern| abort("#{ARGV.fetch(0)} missing #{name}") unless source.match?(pattern) }
  ' "$public_doc"
done

