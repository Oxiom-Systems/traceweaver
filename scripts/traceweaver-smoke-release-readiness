ruby -e '
  source = File.read(ARGV.fetch(0))
  after_on = source.split(/^on:\n/, 2)[1] or abort("release workflow event block missing")
  event_block = after_on.split(/^concurrency:/, 2)[0]
  normalized = event_block.lines.reject { |line| line.strip.empty? || line.start_with?("#") }.map(&:rstrip).join("\n")
  expected = "  push:\n    branches: [main]"
  abort("release workflow must trigger only on push to main") unless normalized == expected
  abort("release workflow must not trigger on pull requests") if source.match?(/^\s*pull_request(?:_target)?:/)
' "$workflow"
if grep -Eq 'pr3_reconciled_head|pr3_ci_run|tag_absent_before_merge' "$checker"; then
  echo "release_readiness_self_reference=unexpected_required_field" >&2
  exit 1
fi
if grep -Eq 'tw-graph.*build|traceweaver-tw-graph build' "$workflow"; then
  echo "release_workflow_graph_self_heal=unexpected_build" >&2
  exit 1
fi
wait_line="$(grep -n 'Wait for exact-SHA smoke and CodeQL' "$workflow" | cut -d: -f1)"
release_line="$(grep -n 'name: Create tag and GitHub Release' "$workflow" | cut -d: -f1)"
if [ -z "$wait_line" ] || [ -z "$release_line" ] || [ "$wait_line" -ge "$release_line" ]; then
  echo "release_workflow_order=invalid" >&2
  exit 1
fi

