def fail_check(message)
  warn "release-readiness-check: #{message}"
  exit 1
end

def normalized_relative_path(value, label)
  fail_check("#{label} must be a non-empty string") unless value.is_a?(String) && !value.empty?
  relative = Pathname.new(value)
  if relative.absolute? || relative.cleanpath.to_s != value || value.start_with?("../")
    fail_check("#{label} must be normalized and relative: #{value.inspect}")
  end
  value
end

def canonical(value)
  case value
  when Hash
    value.keys.map(&:to_s).sort.each_with_object({}) do |key, output|
      source_key = value.key?(key) ? key : value.keys.find { |candidate| candidate.to_s == key }
      output[key] = canonical(value.fetch(source_key))
    end
  when Array
    value.map { |entry| canonical(entry) }
  else
    value
  end
end

def semantic_digest(value)
  "sha256:#{Digest::SHA256.hexdigest(JSON.generate(canonical(value)))}"
end

def file_sha256(path)
  "sha256:#{Digest::SHA256.file(path).hexdigest}"
end

def file_scope_digest(root_path, paths)
  records = paths.sort.map do |path|
    absolute = root_regular_file(root_path, path, "reviewed behavior path")
    git_mode = (absolute.stat.mode & 0o111).zero? ? "100644" : "100755"
    "#{path}\0#{git_mode}\0#{Digest::SHA256.file(absolute).hexdigest}\n"
  end
  "sha256:#{Digest::SHA256.hexdigest(records.join)}"
end

def root_regular_file(root_path, relative, label)
  absolute = root_path.join(relative)
  fail_check("#{label} is missing or not a regular file: #{relative}") unless absolute.file? && !absolute.symlink?
  resolved = absolute.realpath
  root_prefix = "#{root_path}#{File::SEPARATOR}"
  fail_check("#{label} escapes repository root: #{relative}") unless resolved.to_s.start_with?(root_prefix)
  absolute
rescue Errno::ENOENT, Errno::EACCES => e
  fail_check("#{label} cannot be resolved: #{relative}: #{e.message}")
end

def parse_front_matter(path, label)
  source = File.read(path)
  front_matter = source.match(/\A---[ \t]*\n(.*?)\n---[ \t]*(?:\n|\z)/m)
  fail_check("missing YAML front matter in #{label}") unless front_matter
  data = YAML.safe_load(front_matter[1], permitted_classes: [Date], aliases: false)
  fail_check("front matter is not a mapping in #{label}") unless data.is_a?(Hash)
  [data, source]
rescue Psych::Exception => e
  fail_check("invalid YAML front matter in #{label}: #{e.message}")
end

def git_capture(root_path, *arguments)
  output, error, status = Open3.capture3("git", "-C", root_path.to_s, *arguments)
  fail_check("git #{arguments.join(' ')} failed: #{error.strip}") unless status.success?
  output
end

def assert_resolved_release_base(root_path, released_base)
  _output, _error, status = Open3.capture3(
    "git", "-C", root_path.to_s, "cat-file", "-e", "#{released_base}^{commit}"
  )
  fail_check("released_base does not resolve to a commit: #{released_base}") unless status.success?
  _output, _error, status = Open3.capture3(
    "git", "-C", root_path.to_s, "merge-base", "--is-ancestor", released_base, "HEAD"
  )
  fail_check("released_base is not an ancestor of repository HEAD: #{released_base}") unless status.success?
end

def production_delta(root_path, released_base)
  fields = git_capture(root_path, "diff", "--name-status", "--no-renames", "-z", released_base, "--").split("\0")
  fail_check("could not parse production delta") unless fields.length.even?
  tracked = {}
  fields.each_slice(2) do |status, path|
    next if status.nil? || status.empty?
    normalized_relative_path(path, "changed path")
    fail_check("production candidate contains deleted path #{path}; deletions are not authorized") if status.start_with?("D")
    fail_check("unsupported git delta status #{status.inspect} for #{path}") unless status.match?(/\A[AMT]\z/)
    tracked[path] = status
  end
  untracked = git_capture(root_path, "ls-files", "--others", "--exclude-standard", "-z").split("\0").reject(&:empty?)
  untracked.each do |path|
    normalized_relative_path(path, "untracked path")
    tracked[path] ||= "?"
  end
  tracked
end

def load_canonical_map(root_path, candidate_paths)
  fail_check("canonical model-context map must be bound by candidate_scope") unless candidate_paths.include?(READINESS_V2_MAP_PATH)
  map_path = root_regular_file(root_path, READINESS_V2_MAP_PATH, "canonical model-context map")
  map = YAML.safe_load(File.read(map_path), permitted_classes: [], aliases: false)
  fail_check("canonical model-context map is not a mapping") unless map.is_a?(Hash)
  fail_check("canonical model-context map schema is invalid") unless map["schema_version"] == "tw-model-context-map/1"
  map_digest = map["map_digest"]
  fail_check("canonical model-context map digest is invalid") unless map_digest.is_a?(String) && map_digest.match?(SHA256_IDENTITY)
  actual_digest = semantic_digest(map.reject { |key, _value| key == "map_digest" })
  fail_check("canonical model-context map digest mismatch") unless map_digest == actual_digest
  fail_check("canonical model-context source categories are invalid") unless map.dig("source_oracle", "categories") == READINESS_V2_SOURCE_CATEGORIES
  [map, map_path, map_digest]
rescue Psych::Exception => e
  fail_check("canonical model-context map is invalid YAML: #{e.message}")
end

def load_inventory(root_path, candidate_paths, map_path, map_digest, expected_route_count: 87)
  fail_check("model-context inventory generator must be bound by candidate_scope") unless candidate_paths.include?(READINESS_V2_INVENTORY_GENERATOR)
  generator = root_regular_file(root_path, READINESS_V2_INVENTORY_GENERATOR, "model-context inventory generator")
  fail_check("model-context inventory generator is not executable") unless generator.executable?
  output, error, status = Open3.capture3(
    generator.to_s, "--root", root_path.to_s, "--map", map_path.to_s, "--format", "json"
  )
  fail_check("model-context inventory generation failed: #{error.strip}") unless status.success?
  inventory = JSON.parse(output)
  fail_check("model-context inventory is not a mapping") unless inventory.is_a?(Hash)
  fail_check("model-context inventory schema is invalid") unless inventory["schema_version"] == "tw-model-context-inventory/1"
  fail_check("model-context inventory map digest mismatch") unless inventory["map_digest"] == map_digest
  routes = inventory["routes"]
  fail_check("model-context inventory routes are invalid") unless routes.is_a?(Array) && routes.length == expected_route_count
  route_ids = routes.map { |route| route.is_a?(Hash) && route["route_id"] }
  fail_check("model-context inventory route identities are invalid") unless route_ids.all? { |route_id| route_id.is_a?(String) && !route_id.empty? } && route_ids.uniq.length == expected_route_count
  expected_declared = expected_route_count == 87 ? 88 : expected_route_count
  fail_check("model-context inventory route count is invalid") unless inventory["declared_route_count"] == expected_declared && inventory["top_level_callable_count"] == 29
  actual_inventory_digest = semantic_digest(routes)
  fail_check("model-context inventory digest mismatch") unless inventory["inventory_digest"] == actual_inventory_digest
  [inventory, actual_inventory_digest]
rescue JSON::ParserError => e
  fail_check("model-context inventory generator returned invalid JSON: #{e.message}")
end

def validate_oracle_cell!(root_path, map, inventory_by_route, cell)
  fail_check("oracle route/category cell is not a mapping") unless cell.is_a?(Hash)
  route_id = cell["route_id"]
  category = cell["category"]
  fail_check("oracle route/category cell has an unknown route") unless inventory_by_route.key?(route_id)
  fail_check("oracle route/category cell has an unknown category") unless READINESS_V2_SOURCE_CATEGORIES.include?(category)
  disposition = cell["disposition"]
  fail_check("oracle route/category cell is held or invalid: #{route_id}/#{category}") unless %w[satisfied excluded_by_authority].include?(disposition)

  mandatory_all = map.dig("source_oracle", "mandatory_all_routes")
  if disposition == "excluded_by_authority"
    fail_check("oracle mandatory category is excluded: #{route_id}/#{category}") if mandatory_all.include?(category)
    unless cell["exclusion_authority"].is_a?(String) && !cell["exclusion_authority"].empty? &&
           cell["exclusion_rationale"].is_a?(String) && !cell["exclusion_rationale"].empty?
      fail_check("oracle exclusion is unexplained: #{route_id}/#{category}")
    end
    return
  end

  references = cell["source_refs"]
  fail_check("oracle satisfied cell lacks source references: #{route_id}/#{category}") unless references.is_a?(Array) && !references.empty?
  references.each do |reference|
    unless reference.is_a?(Hash) && reference["source_manifest_category"] == category &&
           reference["digest"].is_a?(String) && reference["digest"].match?(SHA256_IDENTITY)
      fail_check("oracle source reference is invalid: #{route_id}/#{category}")
    end
    locator = normalized_relative_path(reference["locator"], "oracle source locator")
    source_path = root_regular_file(root_path, locator, "oracle source")
    fail_check("oracle source digest mismatch: #{route_id}/#{category}:#{locator}") unless reference["digest"] == file_sha256(source_path)
  end
end

def load_canonical_oracle(root_path, candidate_paths, map, map_digest, inventory, inventory_digest, expected_route_count: 87)
  fail_check("canonical model-context oracle must be bound by candidate_scope") unless candidate_paths.include?(READINESS_V2_ORACLE_PATH)
  oracle_path = root_regular_file(root_path, READINESS_V2_ORACLE_PATH, "canonical model-context oracle")
  oracle = JSON.parse(File.read(oracle_path))
  fail_check("canonical model-context oracle is not a mapping") unless oracle.is_a?(Hash)
  fail_check("canonical model-context oracle schema is invalid") unless oracle["schema_version"] == "tw-model-context-oracle-adequacy-review/1"
  fail_check("canonical model-context oracle map digest mismatch") unless oracle["map_digest"] == map_digest
  fail_check("canonical model-context oracle inventory digest mismatch") unless oracle["inventory_digest"] == inventory_digest
  oracle_digest = oracle["oracle_digest"]
  fail_check("canonical model-context oracle digest is invalid") unless oracle_digest.is_a?(String) && oracle_digest.match?(SHA256_IDENTITY)
  actual_oracle_digest = semantic_digest(oracle.reject { |key, _value| key == "oracle_digest" })
  fail_check("canonical model-context oracle digest mismatch") unless oracle_digest == actual_oracle_digest

  reviewer = oracle["reviewer"]
  unless reviewer.is_a?(Hash) && reviewer["identity"].is_a?(String) && !reviewer["identity"].empty? &&
         reviewer["relationship"].is_a?(String) && !reviewer["relationship"].empty? && reviewer["independent"] == true
    fail_check("canonical model-context oracle reviewer is invalid")
  end
  fail_check("canonical model-context oracle uses a generic pre-validation reviewer") if reviewer["identity"] == "independent-validation-reviewer"
  unless reviewer["identity"].match?(/\Aterra-integrated-reviewer:[A-Za-z0-9_\/-]+\z/)
    fail_check("canonical model-context oracle reviewer identity is not an authorized Terra integrated reviewer")
  end
  unless reviewer["relationship"] == READINESS_V2_ORACLE_REVIEWER_RELATIONSHIP
    fail_check("canonical model-context oracle reviewer relationship is invalid")
  end

  routes = inventory.fetch("routes")
  inventory_by_route = routes.to_h { |route| [route.fetch("route_id"), route] }
  cells = oracle["route_category_cells"]
  expected_pairs = inventory_by_route.keys.product(READINESS_V2_SOURCE_CATEGORIES).sort
  actual_pairs = cells.is_a?(Array) ? cells.map { |cell| [cell["route_id"], cell["category"]] } : []
  expected_cell_count = expected_route_count * READINESS_V2_SOURCE_CATEGORIES.length
  fail_check("canonical model-context oracle route count is invalid") unless oracle["route_count"] == expected_route_count
  fail_check("canonical model-context oracle category count is invalid") unless oracle["category_count"] == 6
  fail_check("canonical model-context oracle must contain #{expected_cell_count} cells") unless cells.is_a?(Array) && cells.length == expected_cell_count
  fail_check("canonical model-context oracle cells are not unique") unless actual_pairs.uniq.length == expected_cell_count
  fail_check("canonical model-context oracle route/category coverage is invalid") unless actual_pairs.sort == expected_pairs
  cells.each { |cell| validate_oracle_cell!(root_path, map, inventory_by_route, cell) }

  route_kind_routes = map.fetch("route_kinds").values.flatten
  cells.group_by { |cell| cell.fetch("route_id") }.each do |route_id, route_cells|
    canonical_route = inventory_by_route.fetch(route_id).fetch("canonical_route_id")
    next unless route_kind_routes.include?(canonical_route)
    %w[implementation_dependencies accepted_evidence].each do |category|
      cell = route_cells.find { |candidate| candidate.fetch("category") == category }
      fail_check("oracle route-kind obligation is not satisfied: #{route_id}/#{category}") unless cell && cell["disposition"] == "satisfied"
    end
  end
  if expected_route_count == 88
    READINESS_V3_LIFECYCLE_ORACLE_REFS.each do |category, expected_locators|
      cell = cells.find { |candidate| candidate["route_id"] == "tw-lifecycle" && candidate["category"] == category }
      actual_locators = Array(cell && cell["source_refs"]).map { |reference| reference["locator"] }.sort
      fail_check("Core 0.6.0 tw-lifecycle oracle source set is incomplete for #{category}") unless actual_locators == expected_locators
    end
  end
  fail_check("canonical model-context oracle contains open or uncertain cells") unless oracle["open_or_uncertain_cells"] == []
  [oracle, oracle_path, oracle_digest, reviewer]
rescue JSON::ParserError => e
  fail_check("canonical model-context oracle is invalid JSON: #{e.message}")
end

def validate_model_context_artifacts(root_path, candidate_paths, expected_route_count: 87)
  map, map_path, map_digest = load_canonical_map(root_path, candidate_paths)
  inventory, inventory_digest = load_inventory(root_path, candidate_paths, map_path, map_digest, expected_route_count: expected_route_count)
  oracle, oracle_path, oracle_digest, reviewer = load_canonical_oracle(
    root_path, candidate_paths, map, map_digest, inventory, inventory_digest,
    expected_route_count: expected_route_count
  )
  {
    map_digest: map_digest,
    map_file_sha256: file_sha256(map_path),
    oracle_digest: oracle_digest,
    oracle_file_sha256: file_sha256(oracle_path),
    inventory_digest: inventory_digest,
    oracle_review_id: oracle.fetch("review_id"),
    oracle_reviewer: reviewer,
    route_count: expected_route_count,
    cell_count: expected_route_count * READINESS_V2_SOURCE_CATEGORIES.length
  }
end

def assert_graph_receipt(path, expected_cycle: READINESS_V2_GRAPH_CYCLE)
  data = JSON.parse(File.read(path))
  fail_check("graph freshness receipt is not a mapping") unless data.is_a?(Hash)
  fail_check("graph freshness schema_version is invalid") unless data["schema_version"] == "tw-graph-freshness-receipt/1"
  if expected_cycle
    fail_check("graph freshness cycle_id is invalid") unless data["cycle_id"] == expected_cycle
  else
    fail_check("graph freshness cycle_id is invalid") unless data["cycle_id"].is_a?(String) && !data["cycle_id"].empty?
  end
  fail_check("graph freshness producer is invalid") unless data["producer"] == "traceweaver-tw-graph"
  fail_check("graph freshness authority is invalid") unless data["authority"] == "derived_freshness_evidence_only"
  %w[baseline_hash closure_identity graph_hash manifest_hash receipt_hash].each do |field|
    fail_check("graph freshness #{field} is invalid") unless data[field].is_a?(String) && data[field].match?(SHA256_IDENTITY)
  end
  fail_check("graph freshness closure_count is invalid") unless data["closure_count"].is_a?(Integer) && data["closure_count"].positive?
  fail_check("graph freshness materialization_count is invalid") unless data["materialization_count"].is_a?(Integer) && data["materialization_count"].positive?
rescue JSON::ParserError => e
  fail_check("graph freshness receipt is invalid JSON: #{e.message}")
end

def assert_derived_carrier_freshness(root_path)
  [
    [READINESS_V2_GENERATED_VIEW_CHECK, "generated traceability-view drift check", "traceability_generated_views_smoke=pass"],
    [READINESS_V2_CURRENT_SNAPSHOT_CHECK, "current Intent Contract snapshot drift check", "traceweaver_verify=pass"]
  ].each do |relative, label, pass_marker|
    script = root_regular_file(root_path, relative, label)
    fail_check("#{label} is not executable") unless script.executable?
    output, error, status = Open3.capture3(script.to_s, chdir: root_path.to_s)
    next if status.success? && output.include?(pass_marker)

    detail = [error.strip, output.strip].reject(&:empty?).join(" | ")
    fail_check("#{label} rejected production derived carriers: #{detail}")
  end
end

def assert_evidence_front_matter(path, label, expected_id, expected_status)
  data, = parse_front_matter(path, label)
  fail_check("#{label} id must be #{expected_id.inspect}") unless data["id"] == expected_id
  fail_check("#{label} status must be #{expected_status.inspect}") unless data["status"] == expected_status
  data
end

def expected_artifact_bindings(context)
  {
    "map" => {
      "path" => READINESS_V2_MAP_PATH,
      "file_sha256" => context.fetch(:map_file_sha256),
      "semantic_digest" => context.fetch(:map_digest)
    },
    "oracle" => {
      "path" => READINESS_V2_ORACLE_PATH,
      "file_sha256" => context.fetch(:oracle_file_sha256),
      "semantic_digest" => context.fetch(:oracle_digest)
    },
    "inventory" => {
      "generator" => READINESS_V2_INVENTORY_GENERATOR,
      "semantic_digest" => context.fetch(:inventory_digest),
      "route_count" => context.fetch(:route_count),
      "route_category_cell_count" => context.fetch(:cell_count)
    }
  }
end

def assert_shared_evidence_bindings(data, label, context, behavior_digest, behavior_path_count)
  fail_check("#{label} reviewed_behavior_digest mismatch") unless data["reviewed_behavior_digest"] == behavior_digest
  fail_check("#{label} reviewed_behavior_path_count mismatch") unless data["reviewed_behavior_path_count"] == behavior_path_count
  fail_check("#{label} artifact_bindings mismatch") unless data["artifact_bindings"] == expected_artifact_bindings(context)
end

def assert_structured_acceptance(root_path, path, identity, context, behavior_digest, behavior_path_count)
  acceptance, = parse_front_matter(path, "acceptance result evidence")
  fail_check("acceptance result evidence record_type is invalid") unless acceptance["record_type"] == "traceweaver_acceptance_result"
  fail_check("acceptance result evidence schema_version is invalid") unless acceptance["schema_version"] == 1
  fail_check("acceptance result evidence result_id is invalid") unless acceptance["result_id"] == identity.fetch("acceptance_result_id")
  fail_check("acceptance result evidence status must be \"pass\"") unless acceptance["status"] == "pass"
  fail_check("acceptance result evidence need_ids are invalid") unless acceptance["need_ids"] == ["NEED-TW-013"]
  fail_check("acceptance result evidence owner is invalid") unless acceptance["owner"] == "Oxiom Systems"
  fail_check("acceptance result evidence date is invalid") unless acceptance["date"].to_s == "2026-08-22"
  {
    "requirement_id" => READINESS_V2_REQUIREMENT,
    "linked_trace_id" => identity.fetch("trace_id"),
    "linked_atp_id" => identity.fetch("acceptance_test_id"),
    "linked_result_id" => identity.fetch("acceptance_result_id"),
    "linked_verification_id" => identity.fetch("verification_id"),
    "linked_validation_id" => identity.fetch("validation_id")
  }.each do |field, expected|
    fail_check("acceptance result evidence #{field} must be #{expected.inspect}") unless acceptance[field] == expected
  end
  assert_shared_evidence_bindings(acceptance, "acceptance result evidence", context, behavior_digest, behavior_path_count)
  structured = acceptance["structured_acceptance"]
  fail_check("acceptance result evidence structured_acceptance is invalid") unless structured.is_a?(Hash)
  fail_check("acceptance result evidence final disposition must be \"pass\"") unless structured["final_disposition"] == "pass"
  fail_check("acceptance result evidence tested artifact is not the reviewed behavior") unless structured["tested_baseline_or_artifact_version"] == behavior_digest
  functional = structured["functional_acceptance_evidence"]
  expected_functional = %w[
    scripts/traceweaver-smoke-model-context-routing
    scripts/traceweaver-smoke-installer-transaction
    scripts/traceweaver-smoke-release-readiness
  ]
  functional_evidence = functional.is_a?(Hash) ? functional["evidence"] : nil
  unless functional.is_a?(Hash) && functional["status"] == "present" && functional_evidence.is_a?(Array) &&
         (expected_functional - functional_evidence).empty?
    fail_check("acceptance result evidence lacks the bounded functional smoke set")
  end

  checker = root_regular_file(root_path, READINESS_V2_ACCEPTANCE_CHECKER, "structured acceptance-result checker")
  relative = path.relative_path_from(root_path).to_s
  output, error, status = Open3.capture3(checker.to_s, "--root", root_path.to_s, "--file", relative)
  unless status.success? && output.include?("acceptance_result_status=pass") && output.include?("acceptance_result_findings=0")
    fail_check("structured acceptance-result checker rejected production evidence: #{[error.strip, output.strip].reject(&:empty?).join(' | ')}")
  end
  acceptance
end

def assert_production_evidence(root_path, evidence, identity, context, behavior_digest, behavior_path_count)
  unless evidence.keys.sort == READINESS_V2_PRODUCTION_EVIDENCE.keys.sort
    fail_check("production evidence keys must exactly match the release contract")
  end
  READINESS_V2_PRODUCTION_EVIDENCE.each do |field, expected|
    fail_check("production evidence #{field} must be #{expected.inspect}") unless evidence[field] == expected
  end

  plan = assert_evidence_front_matter(
    root_path.join(evidence.fetch("plan")), "plan evidence",
    identity.fetch("plan_id"), "accepted_doc_review_passed"
  )
  fail_check("plan evidence trace is invalid") unless plan["trace"] == READINESS_V2_TRACE

  plan_review = assert_evidence_front_matter(
    root_path.join(evidence.fetch("plan_document_review")), "plan document review evidence",
    identity.fetch("plan_review_id"), "pass_after_one_consolidated_repair"
  )
  unless plan_review["reviewer"].is_a?(String) && !plan_review["reviewer"].empty? &&
         plan_review["reviewer_relationship"] == "did_not_author_or_edit_reviewed_package"
    fail_check("plan document review evidence lacks its independent reviewer binding")
  end

  code_review = assert_evidence_front_matter(
    root_path.join(evidence.fetch("code_review_series")), "code review evidence",
    identity.fetch("code_review_series_id"), "closed_clean"
  )
  unless code_review["reviewer"].is_a?(String) && !code_review["reviewer"].empty? &&
         code_review["reviewer_relationship"] == "did_not_author_or_edit_reviewed_package"
    fail_check("code review evidence lacks its independent reviewer binding")
  end
  assert_shared_evidence_bindings(code_review, "code review evidence", context, behavior_digest, behavior_path_count)
  expected_findings = { "open_p0" => 0, "open_p1" => 0, "repair_cycle_count" => 1 }
  fail_check("code review evidence lacks the closed consolidated review result") unless code_review["reviewed_findings"] == expected_findings

  assert_structured_acceptance(
    root_path,
    root_path.join(evidence.fetch("acceptance_result")),
    identity,
    context,
    behavior_digest,
    behavior_path_count
  )
  verification = assert_evidence_front_matter(
    root_path.join(evidence.fetch("verification_result")), "verification result evidence",
    identity.fetch("verification_id"), "passed"
  )
  claims = verification["evidence_claims"]
  fail_check("verification result evidence lacks evidence_claims") unless claims.is_a?(Hash)
  READINESS_V2_VERIFICATION_CLAIMS.each do |claim|
    fail_check("verification result evidence claim #{claim} must be \"passed\"") unless claims[claim] == "passed"
  end
  assert_shared_evidence_bindings(verification, "verification result evidence", context, behavior_digest, behavior_path_count)
  expected_checks = %w[
    model_context_routing
    installer_transaction
    release_readiness
    structured_acceptance
    generated_view_drift
    current_snapshot_drift
    manifest_equality
    public_claim_scan
    v1_invariance
  ]
  checks = verification["executed_checks"]
  fail_check("verification result evidence lacks executed_checks") unless checks.is_a?(Hash)
  expected_checks.each do |check|
    fail_check("verification result executed check #{check} must be \"passed\"") unless checks[check] == "passed"
  end

  validation = assert_evidence_front_matter(
    root_path.join(evidence.fetch("validation_result")), "validation result evidence",
    identity.fetch("validation_id"), "accepted"
  )
  oracle_reviewer = context.fetch(:oracle_reviewer)
  fail_check("validation result rater must equal the canonical oracle reviewer identity") unless validation["rater"] == oracle_reviewer.fetch("identity")
  fail_check("validation result rater relationship must equal the canonical oracle reviewer relationship") unless validation["rater_relationship"] == oracle_reviewer.fetch("relationship")
  fail_check("validation result oracle review id mismatch") unless validation["oracle_review_id"] == context.fetch(:oracle_review_id)
  fail_check("validation result evidence must record all 522 oracle cells") unless validation["reviewed_oracle_cells"] == context.fetch(:cell_count)
  assert_shared_evidence_bindings(validation, "validation result evidence", context, behavior_digest, behavior_path_count)
  scenario_results = validation["scenario_results"]
  expected_scenarios = %w[b0 b1 b2 b3 negative_holds v1_invariance claim_boundary complete_oracle_review]
  fail_check("validation result evidence lacks scenario_results") unless scenario_results.is_a?(Hash)
  expected_scenarios.each do |scenario|
    fail_check("validation result scenario #{scenario} must be \"passed\"") unless scenario_results[scenario] == "passed"
  end

  trace_source = File.read(root_path.join(evidence.fetch("traceability")))
  [READINESS_V2_REQUIREMENT, READINESS_V2_TRACE, READINESS_V2_VERIFICATION, READINESS_V2_VALIDATION].each do |anchor|
    fail_check("traceability evidence is missing #{anchor}") unless trace_source.include?(anchor)
  end
  assert_graph_receipt(root_path.join(evidence.fetch("graph_freshness")))
end

def assert_runtime_receipt(path, version, tag, merge_sha, scope_digest, workflow_prefix)
  fail_check("runtime receipt is missing or not a regular file: #{path}") unless path.file? && !path.symlink?
  fail_check("invalid runtime merge SHA #{merge_sha.inspect}") unless merge_sha.match?(GIT_SHA)
  fail_check("invalid runtime candidate scope digest #{scope_digest.inspect}") unless scope_digest.match?(SHA256_IDENTITY)
  fail_check("runtime tag must be traceweaver-core--v#{version}") unless tag == "traceweaver-core--v#{version}"
  unless workflow_prefix.match?(%r{\Ahttps://[^/]+/[^/]+/[^/]+/actions/runs/\z})
    fail_check("invalid runtime workflow URL prefix #{workflow_prefix.inspect}")
  end

  data = JSON.parse(File.read(path))
  fail_check("runtime receipt is not a mapping") unless data.is_a?(Hash)
  required_keys = %w[schema version tag merge_sha candidate_scope_digest workflow_url required_ci]
  fail_check("runtime receipt keys are invalid") unless data.keys.sort == required_keys.sort
  {
    "schema" => RUNTIME_RECEIPT_SCHEMA,
    "version" => version,
    "tag" => tag,
    "merge_sha" => merge_sha,
    "candidate_scope_digest" => scope_digest
  }.each do |field, expected|
    fail_check("runtime receipt #{field} must be #{expected.inspect}") unless data[field] == expected
  end
  workflow_url = data["workflow_url"]
  run_id = workflow_url.is_a?(String) && workflow_url.delete_prefix(workflow_prefix)
  fail_check("runtime receipt workflow_url is invalid") unless workflow_url.is_a?(String) && workflow_url.start_with?(workflow_prefix) && run_id.match?(/\A[1-9][0-9]*\z/)

  required_ci = data["required_ci"]
  fail_check("runtime receipt required_ci is not a mapping") unless required_ci.is_a?(Hash)
  fail_check("runtime receipt required_ci schema is invalid") unless required_ci["schema"] == REQUIRED_CI_SCHEMA
  fail_check("runtime receipt required_ci SHA is invalid") unless required_ci["sha"] == merge_sha
  fail_check("runtime receipt required_ci state is not ready") unless required_ci["state"] == "ready"
  fail_check("runtime receipt required_ci terminal_state must be null") unless required_ci["terminal_state"].nil?
  fail_check("runtime receipt required_ci missing checks must be empty") unless required_ci["missing"] == []
  smoke = required_ci["smoke"]
  unless smoke.is_a?(Hash) && smoke["name"] == "smoke" && smoke["app_slug"] == "github-actions" &&
         smoke["status"] == "completed" && smoke["conclusion"] == "success" &&
         smoke["details_url"].is_a?(String) && smoke["details_url"].start_with?(workflow_prefix) &&
         smoke["id"].is_a?(Integer) && smoke["id"].positive?
    fail_check("runtime receipt required_ci smoke proof is invalid")
  end
  codeql = required_ci["codeql"]
  fail_check("runtime receipt required_ci CodeQL proof is invalid") unless codeql.is_a?(Array) && codeql.length == REQUIRED_CODEQL_NAMES.length
  fail_check("runtime receipt required_ci CodeQL entry is invalid") unless codeql.all? { |entry| entry.is_a?(Hash) }
  fail_check("runtime receipt required_ci CodeQL names are invalid") unless codeql.map { |entry| entry["name"] }.sort == REQUIRED_CODEQL_NAMES.sort
  codeql.each do |entry|
    unless entry["app_slug"] == "github-actions" && entry["status"] == "completed" &&
           entry["conclusion"] == "success" && entry["details_url"].is_a?(String) &&
           entry["details_url"].start_with?(workflow_prefix) && entry["id"].is_a?(Integer) && entry["id"].positive?
      fail_check("runtime receipt required_ci CodeQL entry is invalid")
    end
  end
rescue JSON::ParserError => e
  fail_check("runtime receipt is invalid JSON: #{e.message}")
end

def nested_value(mapping, path)
  path.reduce(mapping) { |value, key| value.is_a?(Hash) ? value[key] : nil }
end

def assert_v2_manifest_versions(root_path, version)
  MANIFEST_VERSION_PATHS.each do |relative, json_path|
    absolute = root_path.join(relative)
    fail_check("release manifest is missing: #{relative}") unless absolute.file?
    begin
      data = JSON.parse(File.read(absolute))
    rescue JSON::ParserError => e
      fail_check("release manifest is invalid JSON: #{relative}: #{e.message}")
    end
    actual = nested_value(data, json_path).to_s
    fail_check("release manifest #{relative} version #{actual.inspect} does not match #{version.inspect}") unless actual == version
  end
end

def assert_v2(data, readiness, version, root_path, receipt_relative, paths, scope_digest)
  fail_check("#{READINESS_V2_SCHEMA} is reserved for #{READINESS_V2_VERSION}") unless version == READINESS_V2_VERSION

  scope = readiness.fetch("candidate_scope")
  exclusions = scope["excluded_paths"]
  fail_check("candidate_scope excluded_paths must be a unique string array") unless exclusions.is_a?(Array) && exclusions.all? { |path| path.is_a?(String) } && exclusions.uniq.length == exclusions.length
  exclusions.each { |path| normalized_relative_path(path, "candidate_scope excluded path") }
  fail_check("candidate_scope must explicitly exclude #{GRAPH_FRESHNESS_PATH}") unless exclusions.include?(GRAPH_FRESHNESS_PATH)
  fail_check("candidate_scope includes an excluded path") unless (paths & exclusions).empty?

  fail_check("#{READINESS_V2_SCHEMA} receipt must be inside repository root") if receipt_relative.start_with?("../")
  expected_exclusions = [GRAPH_FRESHNESS_PATH, receipt_relative].sort
  fail_check("candidate_scope excluded_paths must contain only graph freshness and its own receipt") unless exclusions.sort == expected_exclusions

  identity = readiness["candidate_identity"]
  fail_check("missing candidate_identity mapping") unless identity.is_a?(Hash)
  READINESS_V2_IDENTITIES.each do |field, expected|
    fail_check("candidate_identity #{field} must be #{expected.inspect}") unless identity[field] == expected
  end
  code_review_id = identity["code_review_series_id"]
  fail_check("candidate_identity code_review_series_id is invalid") unless code_review_id.is_a?(String) && code_review_id.match?(/\ATW-CODE-REVIEW-[A-Z0-9._-]+\z/)
  fail_check("candidate_identity reviewed_scope_digest does not bind candidate_scope") unless identity["reviewed_scope_digest"] == scope_digest

  prerequisites = readiness["prerequisites"]
  fail_check("missing release readiness prerequisites") unless prerequisites.is_a?(Hash)
  READINESS_V2_PREREQUISITES.each do |field, expected|
    fail_check("prerequisite #{field} must be #{expected.inspect}") unless prerequisites[field] == expected
  end
  legacy_fields = prerequisites.keys.grep(/\Apr[12]_/)
  fail_check("#{READINESS_V2_SCHEMA} must not use historical PR1/PR2 prerequisites: #{legacy_fields.join(',')}") unless legacy_fields.empty?

  held_claims = readiness["held_claims"]
  fail_check("held_claims must be a unique string array") unless held_claims.is_a?(Array) && held_claims.all? { |claim| claim.is_a?(String) } && held_claims.uniq.length == held_claims.length
  missing_claims = READINESS_V2_HELD_CLAIMS - held_claims
  fail_check("missing required held claims: #{missing_claims.join(',')}") unless missing_claims.empty?

  evidence = readiness["evidence"]
  fail_check("missing evidence mapping") unless evidence.is_a?(Hash)
  production_receipt = receipt_relative == READINESS_V2_PRODUCTION_RECEIPT
  required_evidence = READINESS_V2_EVIDENCE + (production_receipt ? READINESS_V2_VERIFICATION_CLAIMS : [])
  required_evidence.each do |field|
    relative = normalized_relative_path(evidence[field], "evidence #{field}")
    root_regular_file(root_path, relative, "evidence #{field}")
    next if field == "graph_freshness" && relative == GRAPH_FRESHNESS_PATH
    fail_check("evidence #{field} is not bound by candidate_scope: #{relative}") unless paths.include?(relative)
  end
  fail_check("graph_freshness evidence path must be #{GRAPH_FRESHNESS_PATH}") unless evidence["graph_freshness"] == GRAPH_FRESHNESS_PATH

  if production_receipt
    {
      "id" => READINESS_V2_PRODUCTION_ID,
      "status" => "ready_for_version_bump",
      "version" => READINESS_V2_VERSION,
      "tag" => READINESS_V2_PRODUCTION_TAG,
      "released_base" => READINESS_V2_RELEASED_BASE,
      "requirement" => READINESS_V2_REQUIREMENT,
      "trace" => READINESS_V2_TRACE,
      "verification" => READINESS_V2_VERIFICATION,
      "validation" => READINESS_V2_VALIDATION
    }.each do |field, expected|
      fail_check("production receipt #{field} must be #{expected.inspect}") unless data[field].to_s == expected
    end
    fail_check("production candidate deleted_paths must be empty") unless !scope.key?("deleted_paths") || scope["deleted_paths"] == []
    assert_resolved_release_base(root_path, data.fetch("released_base"))
    context = validate_model_context_artifacts(root_path, paths)
    delta = production_delta(root_path, data.fetch("released_base"))
    permitted_non_scope = [receipt_relative, GRAPH_FRESHNESS_PATH]
    omitted = delta.keys - paths - permitted_non_scope
    fail_check("production candidate scope omits changed paths: #{omitted.sort.join(',')}") unless omitted.empty?
    behavior_paths = (delta.keys - READINESS_V2_BEHAVIOR_DIGEST_EXCLUSIONS).sort
    fail_check("production reviewed behavior set is empty") if behavior_paths.empty?
    behavior_digest = file_scope_digest(root_path, behavior_paths)
    {
      "map_digest" => context.fetch(:map_digest),
      "oracle_digest" => context.fetch(:oracle_digest),
      "inventory_digest" => context.fetch(:inventory_digest),
      "oracle_review_id" => context.fetch(:oracle_review_id),
      "oracle_reviewer_identity" => context.dig(:oracle_reviewer, "identity"),
      "oracle_reviewer_relationship" => context.dig(:oracle_reviewer, "relationship"),
      "reviewed_behavior_digest" => behavior_digest,
      "reviewed_behavior_path_count" => behavior_paths.length
    }.each do |field, expected|
      fail_check("candidate_identity #{field} must be #{expected.inspect}") unless identity[field] == expected
    end
    assert_production_evidence(
      root_path, evidence, identity, context, behavior_digest, behavior_paths.length
    )
    assert_derived_carrier_freshness(root_path)
  elsif !receipt_relative.start_with?("fixtures/release-readiness/")
    fail_check("#{READINESS_V2_SCHEMA} production receipt path must be #{READINESS_V2_PRODUCTION_RECEIPT}")
  end

  assert_v2_manifest_versions(root_path, version) if production_receipt
end

def release_label(previous, current)
  prior = previous.to_s.split(".").map { |value| Integer(value, 10) }
  candidate = current.to_s.split(".").map { |value| Integer(value, 10) }
  fail_check("release versions must use numeric major.minor.patch") unless prior.length == 3 && candidate.length == 3
  return "major" if candidate[0] > prior[0] && candidate[1] == 0 && candidate[2] == 0
  return "minor" if candidate[0] == prior[0] && candidate[1] > prior[1] && candidate[2] == 0
  return "patch" if candidate[0] == prior[0] && candidate[1] == prior[1] && candidate[2] > prior[2]

  fail_check("release version #{current.inspect} is not one monotonic semantic version step after #{previous.inspect}")
rescue ArgumentError
  fail_check("release versions must use numeric major.minor.patch")
end

def manifest_version_at(root_path, revision, relative, json_path)
  source = git_capture(root_path, "show", "#{revision}:#{relative}")
  data = JSON.parse(source)
  nested_value(data, json_path).to_s
rescue JSON::ParserError => e
  fail_check("release base manifest is invalid JSON: #{relative}: #{e.message}")
end

def canonical_requirements_hash(path)
  source = File.binread(path)
  placeholder = source.sub(
    /^(baseline_hash_sha256: ).*$/,
    "\\1CANONICAL_HASH_PLACEHOLDER"
  )
  fail_check("requirements baseline_hash_sha256 field is missing") if placeholder == source
  "sha256:#{Digest::SHA256.hexdigest(placeholder)}"
end

def assert_v3_evidence_front_matter(root_path, relative, label, expected_status, functional_digest)
  path = root_regular_file(root_path, relative, label)
  data, = parse_front_matter(path, label)
  fail_check("#{label} status must be #{expected_status.inspect}") unless data["status"] == expected_status
  if functional_digest
    recorded = data["functional_scope_digest"] || data["candidate_tree_digest"]
    fail_check("#{label} does not bind the frozen functional candidate") unless recorded == functional_digest
  end
  data
end

def load_v3_product_validation(root_path, relative)
  path = root_regular_file(root_path, relative, "product validation result")
  product = JSON.parse(File.read(path))
  fail_check("product validation result is not a mapping") unless product.is_a?(Hash)
  [product, path]
rescue JSON::ParserError => e
  fail_check("product validation result is invalid JSON: #{e.message}")
end

def assert_v3_terminal_validation_truth(root_path, product, product_path, functional_digest)
  unless product.dig("candidate", "tree_digest") == functional_digest
    fail_check("product validation result does not bind the frozen functional candidate")
  end

  capsule_path = root_regular_file(root_path, READINESS_V3_VV_CAPSULE, "V&V capsule")
  capsule = JSON.parse(File.read(capsule_path))
  fail_check("V&V capsule schema is invalid") unless capsule["schema_version"] == "tw-vv-capsule/1"
  validation = capsule["product_validation"]
  fail_check("V&V capsule product_validation is missing") unless validation.is_a?(Hash)
  unless READINESS_V3_ACCEPTED_PRODUCT_VALIDATION_STATUSES.include?(validation["status"])
    fail_check("V&V capsule product validation status must be accepted")
  end
  fail_check("V&V capsule product validation id mismatch") unless validation["validation_id"] == READINESS_V3_VALIDATION
  unless validation["functional_scope_digest"] == functional_digest
    fail_check("V&V capsule product validation does not bind the frozen functional candidate")
  end
  product_digest = file_sha256(product_path)
  fail_check("V&V capsule product result digest mismatch") unless validation["result_digest"] == product_digest

  review_statuses = Array(capsule["requirements"]).flat_map do |requirement|
    Array(requirement.is_a?(Hash) && requirement["reviews"]).map { |review| review.is_a?(Hash) && review["status"] }
  end
  unless !review_statuses.empty? && review_statuses.all? { |status| status == "closed_clean" }
    fail_check("V&V capsule contains a non-clean integrated-review status")
  end
  stale_hold = Array(capsule["held_claims"]).find do |claim|
    claim.to_s.match?(/(?:product validation|product revalidation|revalidation required|historical.*product)/i)
  end
  fail_check("V&V capsule retains a stale product-validation hold: #{stale_hold}") if stale_hold

  requirements = File.read(root_regular_file(root_path, "requirements.md", "controlled requirements"))
  matrix = File.read(root_regular_file(root_path, "traceability-matrix.md", "traceability matrix"))
  unless requirements.include?("successor_terminal_truth_controlled_by_exact_candidate_evidence") &&
         requirements.include?("only the exact current content-bound result")
    fail_check("controlled requirements do not declare exact-candidate product-validation truth")
  end
  unless matrix.include?("VAL-TW-042 is non-compensable and evidence-controlled") &&
         matrix.include?("only a current product result bound to the exact functional digest")
    fail_check("traceability matrix does not declare exact-candidate product-validation truth")
  end
end

def assert_v3_model_context(root_path, evidence, identity, candidate_paths)
  unless evidence["model_context_oracle"] == READINESS_V2_ORACLE_PATH
    fail_check("model-context oracle evidence path must be #{READINESS_V2_ORACLE_PATH}")
  end
  context = validate_model_context_artifacts(root_path, candidate_paths, expected_route_count: 88)
  fail_check("candidate_identity model_context_oracle_digest mismatch") unless identity["model_context_oracle_digest"] == context.fetch(:oracle_digest)
  fail_check("candidate_identity model_context_oracle_review_id mismatch") unless identity["model_context_oracle_review_id"] == context.fetch(:oracle_review_id)
  fail_check("candidate_identity model_context_oracle_reviewer mismatch") unless identity["model_context_oracle_reviewer"] == context.dig(:oracle_reviewer, "identity")
  fail_check("candidate_identity model_context_route_count mismatch") unless identity["model_context_route_count"] == context.fetch(:route_count)
  context
end

def assert_v3_common_evidence(root_path, evidence, identity, functional_digest, candidate_paths)
  product, product_path = load_v3_product_validation(root_path, evidence.fetch("product_validation_result_json"))
  assert_v3_terminal_validation_truth(root_path, product, product_path, functional_digest)
  context = assert_v3_model_context(root_path, evidence, identity, candidate_paths)
  [product, product_path, context]
end

def assert_v3_production_evidence(root_path, evidence, identity, functional_digest, candidate_paths, common)
  requirements_path = root_regular_file(root_path, "requirements.md", "controlled requirements")
  requirements_hash = canonical_requirements_hash(requirements_path)
  unless identity["requirements_hash_sha256"] == requirements_hash
    fail_check("candidate_identity requirements_hash_sha256 does not match canonical requirements")
  end

  product_relative = evidence.fetch("product_validation_result_json")
  product, product_path, context = common
  validator = root_regular_file(
    root_path,
    "plugins/traceweaver-core/skills/tw-lifecycle/scripts/traceweaver-lifecycle-product-validation",
    "product validation validator"
  )
  fail_check("product validation validator is not executable") unless validator.executable?
  output, error, status = Open3.capture3(
    validator.to_s, "--root", root_path.to_s, "--result", product_path.to_s
  )
  unless status.success? && output.include?("product_validation_release_gate=passed")
    fail_check("product validation result did not pass: #{[output.strip, error.strip].reject(&:empty?).join(' | ')}")
  end
  fail_check("product validation candidate requirements hash mismatch") unless product.dig("candidate", "requirements_hash_sha256") == requirements_hash

  representative = assert_v3_evidence_front_matter(
    root_path, evidence.fetch("representative_validation"), "representative validation",
    "accepted", functional_digest
  )
  fail_check("representative validation id must be VAL-TW-042") unless representative["id"] == READINESS_V3_VALIDATION

  review = assert_v3_evidence_front_matter(
    root_path, evidence.fetch("integrated_review"), "integrated review",
    "closed_clean", functional_digest
  )
  fail_check("integrated review identity mismatch") unless review["id"] == identity["review_id"]
  fail_check("integrated review reviewer does not authorize the model-context oracle") unless review["reviewer"] == context.dig(:oracle_reviewer, "identity")
  fail_check("integrated review must record zero open P0") unless review.dig("reviewed_findings", "open_p0") == 0
  fail_check("integrated review must record zero open P1") unless review.dig("reviewed_findings", "open_p1") == 0
  fail_check("integrated review repair count exceeds one") unless review.dig("reviewed_findings", "repair_cycle_count").to_i <= 1

  assert_v3_evidence_front_matter(root_path, evidence.fetch("scope_rollback"), "scope and rollback verification", "passed", functional_digest)
  assert_v3_evidence_front_matter(root_path, evidence.fetch("reinstall"), "clean reinstall verification", "passed", functional_digest)
  assert_v3_evidence_front_matter(root_path, evidence.fetch("release_integrity"), "release-integrity verification", "passed", functional_digest)
  assert_graph_receipt(root_path.join(evidence.fetch("graph_freshness")), expected_cycle: nil)
end

def assert_v3(data, readiness, version, root_path, receipt_relative, paths, scope_digest)
  fail_check("#{READINESS_V3_SCHEMA} is reserved for #{READINESS_V3_VERSION}") unless version == READINESS_V3_VERSION
  fixture = receipt_relative.start_with?("fixtures/release-readiness/")
  production = receipt_relative == READINESS_V3_PRODUCTION_RECEIPT
  unless fixture || production
    fail_check("#{READINESS_V3_SCHEMA} production receipt path must be #{READINESS_V3_PRODUCTION_RECEIPT}")
  end

  expected_top = {
    "status" => "ready_for_version_bump",
    "version" => READINESS_V3_VERSION,
    "tag" => READINESS_V3_PRODUCTION_TAG,
    "requirement" => READINESS_V3_REQUIREMENT,
    "trace" => READINESS_V3_TRACE,
    "verification" => READINESS_V3_VERIFICATION,
    "validation" => READINESS_V3_VALIDATION
  }
  expected_top.each do |field, expected|
    fail_check("release receipt #{field} must be #{expected.inspect}") unless data[field].to_s == expected
  end
  if production
    {
      "id" => READINESS_V3_PRODUCTION_ID,
      "released_predecessor_tag" => READINESS_V3_PREDECESSOR_TAG,
      "released_predecessor_sha" => READINESS_V3_PREDECESSOR_SHA,
      "integration_base" => READINESS_V3_INTEGRATION_BASE
    }.each do |field, expected|
      fail_check("production receipt #{field} must be #{expected.inspect}") unless data[field].to_s == expected
    end
  end

  integration_base = data["integration_base"].to_s
  fail_check("integration_base must be a git SHA") unless integration_base.match?(GIT_SHA)
  assert_resolved_release_base(root_path, integration_base)
  assert_v2_manifest_versions(root_path, version)
  manifest_path, json_path = MANIFEST_VERSION_PATHS.first
  previous_version = manifest_version_at(root_path, integration_base, manifest_path, json_path)
  expected_label = release_label(previous_version, version)
  fail_check("release label must be #{expected_label.inspect}") unless readiness["release_label"] == expected_label
  if production
    fail_check("Core 0.6.0 must be a minor release from 0.5.0") unless previous_version == "0.5.0" && expected_label == "minor"
  end

  changelog = File.read(root_regular_file(root_path, "CHANGELOG.md", "CHANGELOG"))
  fail_check("CHANGELOG lacks the Core 0.6.0 release section") unless changelog.match?(/^## 0\.6\.0\s+-\s+\d{4}-\d{2}-\d{2}$/)
  readme = File.read(root_regular_file(root_path, "README.md", "README"))
  fail_check("README lacks the pinned Core 0.6.0 install tag") unless readme.include?(READINESS_V3_PRODUCTION_TAG)

  scope = readiness.fetch("candidate_scope")
  exclusions = scope["excluded_paths"]
  fail_check("candidate_scope excluded_paths must be a unique string array") unless exclusions.is_a?(Array) && exclusions.all? { |path| path.is_a?(String) } && exclusions.uniq.length == exclusions.length
  exclusions.each { |path| normalized_relative_path(path, "candidate_scope excluded path") }
  expected_exclusions = [GRAPH_FRESHNESS_PATH, receipt_relative].sort
  fail_check("candidate_scope excluded_paths must contain only graph freshness and its own receipt") unless exclusions.sort == expected_exclusions
  fail_check("candidate_scope includes an excluded path") unless (paths & exclusions).empty?

  delta = production_delta(root_path, integration_base)
  allowed_receipts = if fixture
                       delta.keys.grep(%r{\Afixtures/release-readiness/.*\.md\z})
                     else
                       [receipt_relative]
                     end
  omitted = delta.keys - paths - [GRAPH_FRESHNESS_PATH] - allowed_receipts
  fail_check("release candidate scope omits changed paths: #{omitted.sort.join(',')}") unless omitted.empty?
  unexpected = paths - delta.keys
  fail_check("release candidate scope includes unchanged paths: #{unexpected.sort.join(',')}") unless unexpected.empty?

  functional = readiness["functional_scope"]
  fail_check("missing functional_scope mapping") unless functional.is_a?(Hash)
  fail_check("unsupported functional_scope algorithm") unless functional["algorithm"] == SCOPE_ALGORITHM
  functional_paths = functional["paths"]
  unless functional_paths.is_a?(Array) && !functional_paths.empty? && functional_paths.uniq.length == functional_paths.length && (functional_paths - paths).empty?
    fail_check("functional_scope paths must be a unique non-empty candidate-scope subset")
  end
  functional_digest = file_scope_digest(root_path, functional_paths)
  fail_check("functional_scope digest mismatch") unless functional["digest"] == functional_digest
  identity = readiness["candidate_identity"]
  fail_check("missing candidate_identity mapping") unless identity.is_a?(Hash)
  fail_check("candidate_identity functional_scope_digest mismatch") unless identity["functional_scope_digest"] == functional_digest
  fail_check("candidate_identity functional_scope_path_count mismatch") unless identity["functional_scope_path_count"] == functional_paths.length
  fail_check("candidate_identity review_id is invalid") unless identity["review_id"].is_a?(String) && identity["review_id"].start_with?("TW-CODE-REVIEW-")
  fail_check("candidate_identity product_validation_id mismatch") unless identity["product_validation_id"] == READINESS_V3_VALIDATION

  prerequisites = readiness["prerequisites"]
  fail_check("missing release readiness prerequisites") unless prerequisites.is_a?(Hash)
  READINESS_V3_PREREQUISITES.each do |field, expected|
    fail_check("prerequisite #{field} must be #{expected.inspect}") unless prerequisites[field] == expected
  end
  evidence = readiness["evidence"]
  fail_check("missing release readiness evidence mapping") unless evidence.is_a?(Hash)
  READINESS_V3_EVIDENCE.each do |field|
    value = evidence[field]
    fail_check("evidence #{field} path is missing") unless value.is_a?(String) && !value.empty?
    relative = normalized_relative_path(value, "evidence #{field}")
    root_regular_file(root_path, relative, "evidence #{field}")
    next if field == "graph_freshness"
    fail_check("evidence #{field} is not bound by candidate_scope") unless paths.include?(relative)
  end
  fail_check("graph_freshness evidence path must be #{GRAPH_FRESHNESS_PATH}") unless evidence["graph_freshness"] == GRAPH_FRESHNESS_PATH

  held_claims = readiness["held_claims"]
  fail_check("held_claims must be a unique string array") unless held_claims.is_a?(Array) && held_claims.uniq.length == held_claims.length
  missing_holds = READINESS_V3_HELD_CLAIMS - held_claims
  fail_check("missing required held claims: #{missing_holds.join(',')}") unless missing_holds.empty?

  common = assert_v3_common_evidence(root_path, evidence, identity, functional_digest, paths)
  assert_v3_production_evidence(root_path, evidence, identity, functional_digest, paths, common) if production

  fail_check("candidate_scope digest is not the already verified digest") unless scope_digest == scope["digest"]
end

receipt = nil
runtime_receipt = nil
version = nil
root = "."
merge_sha = nil
tag = nil
scope_digest = nil
workflow_prefix = nil
until ARGV.empty?
  flag = ARGV.shift
  value = ARGV.shift
  fail_check(USAGE) unless value

  case flag
  when "--receipt" then receipt = value
  when "--runtime-receipt" then runtime_receipt = value
  when "--version" then version = value
  when "--root" then root = value
  when "--merge-sha" then merge_sha = value
  when "--tag" then tag = value
  when "--scope-digest" then scope_digest = value
  when "--workflow-prefix" then workflow_prefix = value
  else fail_check(USAGE)
  end
end
fail_check(USAGE) if receipt && runtime_receipt

if runtime_receipt
  fail_check(USAGE) unless version && tag && merge_sha && scope_digest && workflow_prefix
  assert_runtime_receipt(Pathname.new(runtime_receipt).expand_path, version, tag, merge_sha, scope_digest, workflow_prefix)
  puts "release_runtime_receipt=valid"
  exit 0
end

fail_check(USAGE) unless receipt && version

root_path = Pathname.new(root).expand_path
fail_check("root is not a directory: #{root}") unless root_path.directory?
root_path = root_path.realpath

if merge_sha
  fail_check("invalid merge SHA #{merge_sha.inspect}") unless merge_sha.match?(GIT_SHA)
  repository_head, git_error, git_status = Open3.capture3("git", "-C", root_path.to_s, "rev-parse", "HEAD")
  fail_check("could not resolve repository HEAD: #{git_error.strip}") unless git_status.success?
  repository_head = repository_head.strip
  fail_check("merge SHA #{merge_sha} does not match checked-out HEAD #{repository_head}") unless repository_head == merge_sha
end

receipt_path = Pathname.new(receipt).expand_path
fail_check("receipt is missing or not a regular file: #{receipt}") unless receipt_path.file? && !receipt_path.symlink?
receipt_path = receipt_path.realpath
data, source = parse_front_matter(receipt_path, receipt)

receipt_version = data["version"].to_s
fail_check("receipt version #{receipt_version.inspect} does not match #{version.inspect}") unless receipt_version == version
begin
  Date.iso8601(data.fetch("date").to_s)
rescue ArgumentError, KeyError
  fail_check("receipt date must be ISO-8601")
end

readiness = data["release_readiness"]
fail_check("missing release_readiness mapping") unless readiness.is_a?(Hash)
fail_check("release_readiness version does not match #{version.inspect}") unless readiness["version"].to_s == version
fail_check("receipt contains a PENDING placeholder") if source.match?(/\bPENDING(?:_[A-Z0-9]+)*\b/)
unless readiness["terminal_status"] == "ready_for_version_bump"
  fail_check("terminal status is not ready_for_version_bump")
end

scope = readiness["candidate_scope"]
fail_check("missing candidate_scope mapping") unless scope.is_a?(Hash)
fail_check("unsupported candidate_scope algorithm") unless scope["algorithm"] == SCOPE_ALGORITHM
paths = scope["paths"]
fail_check("candidate_scope paths must be a non-empty array") unless paths.is_a?(Array) && !paths.empty?
fail_check("candidate_scope paths must be unique strings") unless paths.all? { |path| path.is_a?(String) } && paths.uniq.length == paths.length

records = paths.sort.map do |path|
  normalized_relative_path(path, "candidate_scope path")
  absolute = root_regular_file(root_path, path, "candidate_scope path")
  fail_check("candidate_scope must exclude its own receipt: #{path}") if absolute.expand_path == receipt_path
  fail_check("candidate_scope must exclude #{GRAPH_FRESHNESS_PATH}") if path == GRAPH_FRESHNESS_PATH
  git_mode = (absolute.stat.mode & 0o111).zero? ? "100644" : "100755"
  "#{path}\0#{git_mode}\0#{Digest::SHA256.file(absolute).hexdigest}\n"
end
actual_scope_digest = "sha256:#{Digest::SHA256.hexdigest(records.join)}"
fail_check("candidate_scope digest mismatch: expected #{scope['digest'].inspect}, got #{actual_scope_digest}") unless scope["digest"] == actual_scope_digest

schema = readiness["schema_version"]
if schema.nil? || schema == "tw-release-readiness/1"
  fail_check("release #{version} requires #{READINESS_V2_SCHEMA}") unless version == "0.4.0"
  prerequisites = readiness["prerequisites"]
  fail_check("missing release readiness prerequisites") unless prerequisites.is_a?(Hash)
  prerequisites.each do |field, value|
    fail_check("unready prerequisite #{field}=#{value.inspect}") if value.to_s.match?(UNREADY)
  end
  LEGACY_REQUIRED_PREREQUISITES.each do |field, pattern|
    value = prerequisites[field]
    fail_check("missing prerequisite #{field}") unless value.is_a?(String) && !value.empty?
    fail_check("unready prerequisite #{field}=#{value.inspect}") if value.match?(UNREADY)
    fail_check("invalid prerequisite #{field}=#{value.inspect}") unless value.match?(pattern)
  end
elsif schema == READINESS_V2_SCHEMA
  receipt_relative = receipt_path.relative_path_from(root_path).to_s
  assert_v2(data, readiness, version, root_path, receipt_relative, paths, actual_scope_digest)
elsif schema == READINESS_V3_SCHEMA
  receipt_relative = receipt_path.relative_path_from(root_path).to_s
  assert_v3(data, readiness, version, root_path, receipt_relative, paths, actual_scope_digest)
else
  fail_check("unsupported release_readiness schema #{schema.inspect}")
end

readiness.each do |key, value|
  next unless value.is_a?(String)
  fail_check("unready release_readiness value #{key}=#{value.inspect}") if value.match?(UNREADY)
end

puts "release_readiness=ready_for_version_bump"
puts "release_readiness_schema=#{schema || 'tw-release-readiness/1'}"
puts "release_version=#{version}"
puts "release_candidate_scope_digest=#{actual_scope_digest}"
