#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=skill-execution-contract-smoke; req=REQ-TW-092; trace=TRACE-TW-070; ver=VER-TW-090
# TRACEWEAVER: verifies=VER-TW-090; req=REQ-TW-092; trace=TRACE-TW-070
# TRACEWEAVER: verifies=VER-TW-092; req=REQ-TW-109,REQ-TW-110,REQ-TW-121; trace=TRACE-TW-072

root="$(cd "$(dirname "$0")/.." && pwd)"
resolver="$root/plugins/traceweaver-core/skills/tw-auto/scripts/traceweaver-resolve-skill-execution-contract"
registry="$root/plugins/traceweaver-core/references/skill-execution-contracts.yml"
generator="$root/plugins/traceweaver-core/skills/tw-auto/scripts/traceweaver-generate-skill-execution-contract-registry"

ruby - "$root" "$resolver" "$registry" "$generator" <<'RUBY'
require "json"
require "digest"
require "open3"
require "tmpdir"
require "yaml"
require "fileutils"

root, resolver, registry_path, generator = ARGV

def invoke(resolver, registry, skill, *args)
  output, error, status = Open3.capture3(resolver, "--registry", registry, "--skill", skill, *args)
  [JSON.parse(output), error, status]
end

def invoke_default(resolver, skill, *args)
  output, error, status = Open3.capture3(resolver, "--skill", skill, *args)
  [JSON.parse(output), error, status]
end

def expect!(value, message)
  raise message unless value
end

registry = YAML.safe_load(File.read(registry_path), permitted_classes: [], aliases: false)
skills = registry.fetch("contracts").map { |entry| entry.fetch("skill") }
expect!(skills.length == 28 && registry.fetch("callable_count") == 28, "callable count drift")
expect!(skills == skills.sort && skills.uniq == skills, "registry is not deterministic")
expect!(skills.include?("tw-graph"), "tw-graph contract missing")
callables = Dir.children(File.join(root, "plugins/traceweaver-core/skills")).select do |name|
  File.directory?(File.join(root, "plugins/traceweaver-core/skills", name)) && (name.start_with?("tw-") || name == "lfg")
end.sort
expect!(skills == callables, "registry does not exactly cover callable surface")
metadata = registry.fetch("skill_metadata")
expect!(metadata.keys.sort == skills, "skill metadata does not exactly cover callable surface")
model_context_binding = registry.fetch("model_context_map")
expect!(model_context_binding.fetch("schema_version") == "tw-model-context-map/1", "model-context schema binding drift")
expect!(model_context_binding.fetch("mode") == "advisory_shadow_compile", "model-context mode drift")
expect!(model_context_binding.fetch("authoritative_runtime") == "v1", "model-context changed authoritative runtime")
expect!(model_context_binding.fetch("v1_receipt_projection") == "separate_shadow_artifact_only_v1_unchanged", "model-context v1 receipt boundary drift")
metadata_output, metadata_error, metadata_status = Open3.capture3(resolver, "--registry", registry_path, "--model-context-metadata")
expect!(metadata_status.success?, "separate model-context metadata resolution failed: #{metadata_error}")
model_context_metadata = JSON.parse(metadata_output)
expect!(model_context_metadata.fetch("schema_version") == "tw-model-context-sec-binding/1", "separate model-context metadata schema drift")
expect!(model_context_metadata.fetch("model_call_performed") == false, "SEC model-context inspection performed a call")
expect!(model_context_metadata.fetch("v1_receipt_changed") == false, "SEC model-context inspection changed v1")
metadata.each do |skill, entry|
  source = File.read(File.join(root, "plugins/traceweaver-core/skills", skill, "SKILL.md"))
  expect!(source.include?("traceweaver-resolve-skill-execution-contract"), "#{skill} does not resolve SEC")
  expect!(source.include?("--skill #{skill}"), "#{skill} SEC invocation is not explicitly bound")
  expect!(entry.fetch("governing_requirements") == source.scan(/REQ-TW-\d{3}/).uniq.sort, "#{skill} governing requirements drift")
  expect!(entry.fetch("trace_records") == source.scan(/TRACE-TW-\d{3}/).uniq.sort, "#{skill} trace anchors drift")
  expect!(entry.fetch("verification_records") == source.scan(/VER-TW-\d{3}/).uniq.sort, "#{skill} verification anchors drift")
  expect!(entry.fetch("governing_requirements").include?("REQ-TW-092"), "#{skill} lost SEC requirement anchor")
  expect!(entry.fetch("trace_records").include?("TRACE-TW-070"), "#{skill} lost SEC trace anchor")
  expect!(entry.fetch("verification_records").include?("VER-TW-090"), "#{skill} lost SEC verification anchor")
  expected_source_hash = "sha256:#{Digest::SHA256.file(File.join(root, "plugins/traceweaver-core/skills", skill, "SKILL.md")).hexdigest}"
  expect!(entry.fetch("skill_source_hash") == expected_source_hash, "#{skill} source hash drift")
  references = source.scan(%r{references/[A-Za-z0-9._/-]+}).uniq.sort.map do |reference|
    filename = reference.delete_prefix("references/")
    if filename == "scoped-review-protocol.md" && %w[tw-code-review tw-doc-review tw-work].include?(skill)
      "plugins/traceweaver-core/skills/tw-auto/references/#{filename}"
    elsif filename == "workflow-profile-template.yml" && %w[tw-auto tw-plan tw-work tw-code-review tw-doc-review].include?(skill)
      "plugins/traceweaver-core/skills/tw-auto/references/#{filename}"
    elsif filename == "tw-graph-lifecycle.md"
      "plugins/traceweaver-core/references/#{filename}"
    else
      "plugins/traceweaver-core/skills/#{skill}/references/#{filename}"
    end
  end
  expect!(entry.fetch("packaged_references").sort == references.sort, "#{skill} packaged references drift")
end

first, _error, status = invoke(resolver, registry_path, "tw-plan", "--risk", "L2", "--invocation-id", "one")
expect!(status.success?, "valid contract refused")
expect!(first.fetch("terminal_state") == "resolved", "valid lookup did not resolve")
expect!(first.fetch("static_definition_hash").start_with?("sha256:"), "static hash missing")
expect!(first.fetch("invocation_receipt_id") != first.fetch("static_definition_hash"), "definition and receipt identity conflated")
expect!(first.fetch("authority_promotion") == false, "contract promoted authority")
expect!(first.dig("model_route", "dispatch_state") == "not_dispatched_by_contract_resolution", "SEC lookup dispatched or attested a child")
expect!(first.dig("model_route", "served_model") == "not_applicable", "SEC lookup conflated child attestation")
expect!(!JSON.generate(first).include?("model_context"), "ordinary v1 SEC receipt contains shadow fields")
expect!(first.fetch("contract").keys.sort & %w[authority packaged_references trace_records workflow_profile graph_action verification validation holds allowed_writes next_wrapper] == %w[allowed_writes authority graph_action holds next_wrapper packaged_references trace_records validation verification workflow_profile], "contract fields incomplete")
representative_routes = {
  "tw-auto" => {
    "profile" => "consolidated_delivery",
    "graph_action" => "retained_main_tw_graph_refresh_and_check_after_terminal_review_as_zero_model_mechanical_closure",
    "allowed_writes" => ["approved_scoped_behavior_verification_and_trace_evidence_in_retained_main_session", "terminal_bookkeeping_only_after_integrated_review"],
    "next_wrapper" => "integrated_tw-code-review_or_terminal_hold"
  },
  "tw-audit" => {
    "profile" => "read_only",
    "graph_action" => "tw_graph_status_or_query_without_refresh_optional_graphify_enrichment",
    "allowed_writes" => ["none_during_resolution_or_route"],
    "next_wrapper" => "tw-traceability-check"
  },
  "tw-plan" => {
    "profile" => "authority_administration",
    "graph_action" => "tw_graph_refresh_after_final_authority_bookkeeping_then_check",
    "allowed_writes" => ["controlled_authority_records_only_after_separate_approved_authority"],
    "next_wrapper" => "tw-auto_or_user_requested_plan_handoff"
  },
  "tw-work" => {
    "profile" => "implementation",
    "graph_action" => "tw_graph_impact_before_work_defer_refresh_until_terminal_review_optional_graphify_pre_review",
    "allowed_writes" => ["approved_scoped_project_behavior_only", "no_authority_or_publication_write_by_contract"],
    "next_wrapper" => "tw-auto_integrated_review"
  },
  "tw-code-review" => {
    "profile" => "review",
    "graph_action" => "defer_tw_graph_refresh_and_check_to_retained_main_after_terminal_review_no_reentry",
    "allowed_writes" => ["review_receipt_only_when_separately_authorized"],
    "next_wrapper" => "mechanical_closure_or_same_reviewer_targeted_closure"
  },
  "tw-commit-push-pr" => {
    "profile" => "publication",
    "graph_action" => "tw_graph_check_without_refresh_before_publication",
    "allowed_writes" => ["none_until_separate_publication_capsule"],
    "next_wrapper" => "held_publication_authority_required"
  }
}
representative_routes.each do |skill, expected|
  receipt, _error, route_status = invoke(resolver, registry_path, skill, "--invocation-id", "route-#{skill}")
  expect!(route_status.success?, "#{skill} route refused")
  contract = receipt.fetch("contract")
  expect!(contract.fetch("route_profile") == expected.fetch("profile"), "#{skill} profile drift")
  expect!(contract.fetch("graph_action") == expected.fetch("graph_action"), "#{skill} graph action drift")
  expect!(contract.fetch("allowed_writes") == expected.fetch("allowed_writes"), "#{skill} write boundary drift")
  expect!(contract.fetch("next_wrapper") == expected.fetch("next_wrapper"), "#{skill} next wrapper drift")
  expect!(contract.fetch("authority").fetch("contract_requirement") == "REQ-TW-092", "#{skill} contract authority drift")
  expect!(contract.fetch("trace_records").include?("TRACE-TW-070"), "#{skill} SEC trace chain drift")
  expect!(contract.fetch("verification").fetch("verification") == "VER-TW-090", "#{skill} verification chain drift")
  expect!(contract.fetch("validation").fetch("validation") == "VAL-TW-038", "#{skill} validation chain drift")
  expect!((registry.fetch("defaults").fetch("holds") - contract.fetch("holds")).empty?, "#{skill} lost default holds")
  expect!(contract.fetch("packaged_references").all? { |reference| File.file?(File.join(root, reference)) }, "#{skill} packaged reference missing")
  %w[governing_requirements trace_records verification_records].each do |field|
    next unless expected.key?(field)
    actual = field == "governing_requirements" ? contract.fetch("authority").fetch(field) : (field == "verification_records" ? contract.fetch("verification").fetch("skill_verification_records") : contract.fetch(field))
    expect!(actual == expected.fetch(field), "#{skill} exact #{field} drift")
  end
end
second, _error, status = invoke(resolver, registry_path, "tw-plan", "--risk", "L2", "--invocation-id", "two")
expect!(status.success? && first.fetch("static_definition_hash") == second.fetch("static_definition_hash"), "static hash non-deterministic")
expect!(first.fetch("invocation_receipt_id") != second.fetch("invocation_receipt_id"), "invocation receipt was not distinct")
alias_receipt, _error, status = invoke(resolver, registry_path, "lfg", "--invocation-id", "alias")
expect!(status.success? && alias_receipt.dig("contract", "resolved_skill") == "tw-auto" && alias_receipt.dig("contract", "alias_of") == "tw-auto", "alias resolution failed")
expect!(alias_receipt.dig("contract", "route_profile") == "consolidated_delivery", "lfg did not select consolidated delivery")
expect!(alias_receipt.dig("contract", "next_wrapper") == "integrated_tw-code-review_or_terminal_hold", "lfg retained legacy planning handoff")
auto_receipt, _error, status = invoke(resolver, registry_path, "tw-auto", "--invocation-id", "auto")
expect!(status.success?, "tw-auto contract refused")
%w[governing_requirements trace_records].each do |field|
  alias_value = field == "governing_requirements" ? alias_receipt.dig("contract", "authority", field) : alias_receipt.dig("contract", field)
  auto_value = field == "governing_requirements" ? auto_receipt.dig("contract", "authority", field) : auto_receipt.dig("contract", field)
  expect!((auto_value - alias_value).empty?, "alias omitted tw-auto #{field}")
end
expect!((auto_receipt.dig("contract", "verification", "skill_verification_records") - alias_receipt.dig("contract", "verification", "skill_verification_records")).empty?, "alias omitted tw-auto verification anchors")
expect!((auto_receipt.dig("contract", "packaged_references") - alias_receipt.dig("contract", "packaged_references")).empty?, "alias omitted tw-auto packaged references")
contract_routes = registry.fetch("contracts").to_h { |contract| [contract.fetch("skill"), contract] }
expect!(contract_routes.fetch("tw-doc-review").fetch("next_wrapper") == "mechanical_closure_or_same_reviewer_targeted_closure", "tw-doc-review retained legacy traceability handoff")
expect!(contract_routes.fetch("tw-code-review").fetch("next_wrapper") != "tw-doc-review", "mixed review still fans out to standalone document review")
default_receipt, _error, status = invoke_default(resolver, "tw-plan", "--invocation-id", "default-source")
expect!(status.success? && default_receipt.fetch("terminal_state") == "resolved", "default source registry resolution failed")
missing, _error, status = invoke(resolver, registry_path, "tw-nonexistent")
expect!(!status.success? && missing.fetch("terminal_state") == "missing_contract", "missing contract not terminal")
stale, _error, status = invoke(resolver, registry_path, "tw-plan", "--expected-definition-hash", "sha256:#{'0' * 64}")
expect!(!status.success? && stale.fetch("terminal_state") == "stale_contract", "stale contract not terminal")
unavailable, _error, status = invoke(resolver, registry_path, "tw-plan", "--available-model", "gpt-5.6-sol")
expect!(status.success? && unavailable.fetch("terminal_state") == "resolved" && unavailable.dig("model_route", "dispatch_state") == "not_dispatched_by_contract_resolution", "SEC lookup evaluated child availability")

Dir.mktmpdir("traceweaver-sec-") do |dir|
  installed_root = File.join(dir, "traceweaver-core")
  FileUtils.cp_r(File.join(root, "plugins/traceweaver-core"), installed_root)
  installed_resolver = File.join(installed_root, "skills/tw-auto/scripts/traceweaver-resolve-skill-execution-contract")
  receipt, _error, installed_status = invoke_default(installed_resolver, "tw-plan", "--invocation-id", "default-installed")
  expect!(installed_status.success? && receipt.fetch("terminal_state") == "resolved", "default installed registry resolution failed")
  File.open(File.join(installed_root, "skills/tw-plan/SKILL.md"), "a") { |file| file.puts("\nstale fixture mutation") }
  stale_installed, _error, stale_installed_status = invoke_default(installed_resolver, "tw-plan", "--invocation-id", "stale-installed")
  expect!(!stale_installed_status.success? && stale_installed.fetch("terminal_state") == "stale_contract", "installed skill source drift not terminal")
  invalid = File.join(dir, "invalid.yml")
  File.write(invalid, "schema_version: tw-skill-execution-contract-registry/1\ncontracts: []\n")
  result, _error, status = invoke(resolver, invalid, "tw-plan")
  expect!(!status.success? && result.fetch("terminal_state") == "invalid_contract", "invalid registry not terminal")
  ambiguous = File.join(dir, "ambiguous.yml")
  data = Marshal.load(Marshal.dump(registry))
  data.fetch("contracts") << { "skill" => "tw-plan" }
  data["callable_count"] += 1
  File.write(ambiguous, YAML.dump(data))
  result, _error, status = invoke(resolver, ambiguous, "tw-plan")
  expect!(!status.success? && result.fetch("terminal_state") == "ambiguous_contract", "ambiguous registry not terminal")
  missing_reference = File.join(dir, "missing-reference.yml")
  data = Marshal.load(Marshal.dump(registry))
  data.fetch("contracts").find { |contract| contract.fetch("skill") == "tw-plan" }["skill_reference"] = "plugins/traceweaver-core/skills/tw-plan/MISSING.md"
  File.write(missing_reference, YAML.dump(data))
  result, _error, status = invoke(resolver, missing_reference, "tw-plan")
  expect!(!status.success? && result.fetch("terminal_state") == "invalid_contract" && result.fetch("detail").start_with?("reference_missing:"), "missing packaged reference not terminal")
end

source = File.read(resolver)
expect!(!source.match?(/\b(?:rg|grep)\b/i), "control path contains repository-wide rediscovery")
generator_output, generator_error, generator_status = Open3.capture3(generator, "--root", root)
expect!(generator_status.success? && generator_output.include?("sec_registry_generator=fresh"), "deterministic SEC registry generator drift: #{generator_error}")
puts "skill-execution-contract: PASS"
RUBY
