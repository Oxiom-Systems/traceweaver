#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=traceweaver-no-publication-smoke; req=REQ-TW-043; trace=TRACE-TW-013; ver=VER-TW-022
# TRACEWEAVER: verifies=VER-TW-022; req=REQ-TW-043; trace=TRACE-TW-013
# TRACEWEAVER: verifies=VER-TW-087; req=REQ-TW-037,REQ-TW-056,REQ-TW-057; trace=TRACE-TW-067
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

gh_marker="$tmp_dir/gh-called"
mkdir -p "$tmp_dir/bin"
cat >"$tmp_dir/bin/gh" <<'SH'
#!/usr/bin/env bash
echo "gh called: $*" >>"${TRACEWEAVER_GH_MARKER:?}"
exit 98
SH
chmod +x "$tmp_dir/bin/gh"

export PATH="$tmp_dir/bin:$PATH"
export TRACEWEAVER_GH_MARKER="$gh_marker"
unset TRACEWEAVER_PUBLICATION_GATE

reply_script="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/reply-to-pr-thread"
resolve_script="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/resolve-pr-thread"

set +e
printf 'draft reply with no publication\n' | "$reply_script" THREAD_test >"$tmp_dir/reply.out" 2>"$tmp_dir/reply.err"
reply_status=$?
"$resolve_script" THREAD_test >"$tmp_dir/resolve.out" 2>"$tmp_dir/resolve.err"
resolve_status=$?
export TRACEWEAVER_PUBLICATION_GATE=approved
printf 'draft reply with attempted bypass\n' | "$reply_script" THREAD_bypass >"$tmp_dir/reply-bypass.out" 2>"$tmp_dir/reply-bypass.err"
reply_bypass_status=$?
"$resolve_script" THREAD_bypass >"$tmp_dir/resolve-bypass.out" 2>"$tmp_dir/resolve-bypass.err"
resolve_bypass_status=$?
set -e

if [ "$reply_status" -ne 2 ]; then
  echo "reply_to_pr_thread_expected_exit_2=failed actual=$reply_status"
  exit 1
fi

if [ "$resolve_status" -ne 2 ]; then
  echo "resolve_pr_thread_expected_exit_2=failed actual=$resolve_status"
  exit 1
fi

if [ "$reply_bypass_status" -ne 2 ]; then
  echo "reply_to_pr_thread_bypass_expected_exit_2=failed actual=$reply_bypass_status"
  exit 1
fi

if [ "$resolve_bypass_status" -ne 2 ]; then
  echo "resolve_pr_thread_bypass_expected_exit_2=failed actual=$resolve_bypass_status"
  exit 1
fi

if [ -f "$gh_marker" ]; then
  echo "gh_invocation=failed"
  cat "$gh_marker"
  exit 1
fi

require_present() {
  local file="$1"
  local pattern="$2"
  if ! grep -Fq "$pattern" "$file"; then
    echo "required_marker_missing file=$file pattern=$pattern"
    exit 1
  fi
}

require_absent() {
  local file="$1"
  local pattern="$2"
  if grep -Fq "$pattern" "$file"; then
    echo "forbidden_publication_marker_present file=$file pattern=$pattern"
    exit 1
  fi
}

ce_commit_skill="$repo_root/plugins/traceweaver-core/skills/ce-commit/SKILL.md"
ce_debug_skill="$repo_root/plugins/traceweaver-core/skills/ce-debug/SKILL.md"
ce_compound_refresh_skill="$repo_root/plugins/traceweaver-core/skills/ce-compound-refresh/SKILL.md"
ce_resolve_pr_feedback_skill="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/SKILL.md"
ce_resolve_full_mode="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/references/full-mode.md"
ce_resolve_get_comments="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/get-pr-comments"
ce_resolve_get_thread="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/get-thread-for-comment"
ce_work_unit_state="$repo_root/plugins/traceweaver-core/skills/ce-work/scripts/unit_workspace_state.py"
ce_work_unit_transaction="$repo_root/plugins/traceweaver-core/skills/ce-work/scripts/unit_workspace_transaction.py"
ce_work_unit_jobs="$repo_root/plugins/traceweaver-core/skills/ce-work/scripts/unit_workspace_jobs.py"
ce_work_unit_cli="$repo_root/plugins/traceweaver-core/skills/ce-work/scripts/unit-workspace.py"
ce_work_cross_model="$repo_root/plugins/traceweaver-core/skills/ce-work/scripts/cross-model-work.sh"
ce_doc_review_cross_model="$repo_root/plugins/traceweaver-core/skills/ce-doc-review/scripts/cross-model-doc-review.sh"
ce_brainstorm_elevation="$repo_root/plugins/traceweaver-core/skills/ce-brainstorm/scripts/elevation-dispatch.sh"
ce_plan_elevation="$repo_root/plugins/traceweaver-core/skills/ce-plan/scripts/elevation-dispatch.sh"
ce_code_review_skill="$repo_root/plugins/traceweaver-core/skills/ce-code-review/SKILL.md"
ce_code_review_cross_model="$repo_root/plugins/traceweaver-core/skills/ce-code-review/scripts/cross-model-adversarial-review.sh"
tw_grill_skill="$repo_root/plugins/traceweaver-core/skills/tw-grill/SKILL.md"
lfg_skill="$repo_root/plugins/traceweaver-core/skills/lfg/SKILL.md"
tw_auto_skill="$repo_root/plugins/traceweaver-core/skills/tw-auto/SKILL.md"

require_present "$ce_commit_skill" "direct invocation"
require_present "$ce_debug_skill" "stop before staging, committing, pushing, opening PRs"
require_present "$ce_debug_skill" "#### Skill-owned branch (created in Phase 3): TraceWeaver alpha stop"
require_present "$ce_debug_skill" "Do not stage, commit, push, open a PR, post issue/PR replies"
require_present "$ce_debug_skill" 'draft the `/ce-compound` learning-capture handoff'
require_absent "$ce_debug_skill" "default to commit-and-PR without prompting"
require_absent "$ce_debug_skill" 'Run `/ce-commit-push-pr`'
require_absent "$ce_debug_skill" 'Commit and open a PR (`/ce-commit-push-pr`)'
require_absent "$ce_debug_skill" "commit the resulting learning doc to the same branch and push"

require_present "$ce_compound_refresh_skill" "## Phase 5: TraceWeaver Alpha Stop Before Commit"
require_present "$ce_compound_refresh_skill" "Do not stage files, create commits, create branches, push, or open PRs."
require_present "$ce_compound_refresh_skill" "Report follow-up commit content without publishing"
require_absent "$ce_compound_refresh_skill" "## Phase 5: Commit Changes"
require_absent "$ce_compound_refresh_skill" "Create a branch named for what was refreshed"
require_absent "$ce_compound_refresh_skill" "Commit as a separate commit on the current branch"
require_absent "$ce_compound_refresh_skill" "Create a branch, commit, and open a PR"
require_absent "$ce_compound_refresh_skill" "Commit only the compound-refresh changes"
require_absent "$ce_compound_refresh_skill" "Amend or create a follow-up commit when"
require_absent "$ce_compound_refresh_skill" "push the follow-up commit as well"
require_absent "$ce_compound_refresh_skill" "committed as part of (or immediately after) the Phase 5 commit flow"
require_absent "$ce_compound_refresh_skill" "clean up citations in the same commit"

require_present "$ce_resolve_pr_feedback_skill" "posting PR comments, or resolving review threads"
require_absent "$ce_resolve_full_mode" "If the bundled script is missing, reply with"
require_present "$ce_resolve_full_mode" "Draft reply only."
require_present "$ce_resolve_full_mode" "Never fall back to a mutating"
require_present "$ce_resolve_get_comments" "must match the current checkout origin host"
require_present "$ce_resolve_get_comments" "must match the current checkout origin repository"
require_present "$ce_resolve_get_thread" "must match the current checkout origin host"
require_present "$ce_resolve_get_thread" "must match the current checkout origin repository"
require_present "$ce_work_unit_state" "TraceWeaver package forbids unit workspace commit or ref advancement"
require_absent "$ce_work_unit_state" '"commit-tree"'
require_absent "$ce_work_unit_state" '"update-ref"'
require_present "$ce_work_unit_state" "plan-checkpoint-held-uncommitted"
require_present "$ce_work_unit_cli" "HELD_NEW_WORK_COMMANDS"
require_present "$ce_work_unit_cli" "TraceWeaver alpha holds external unit-workspace"
require_present "$ce_work_unit_jobs" "TraceWeaver alpha holds external unit dispatch"
require_present "$ce_work_unit_jobs" "TraceWeaver alpha holds external unit terminalization and synthetic transport refs"
require_present "$ce_work_unit_transaction" "TraceWeaver alpha holds external unit integration"
require_present "$ce_work_cross_model" "TraceWeaver alpha holds external work egress"
require_present "$ce_doc_review_cross_model" "TraceWeaver packaged cross-model document egress is held"
require_present "$ce_brainstorm_elevation" "TraceWeaver packaged off-host model elevation is held"
require_present "$ce_plan_elevation" "TraceWeaver packaged off-host model elevation is held"
require_present "$ce_code_review_skill" "Cross-model code egress is held and disabled"
require_present "$ce_code_review_cross_model" "TraceWeaver packaged cross-model code egress is held"
require_present "$tw_grill_skill" "Do not edit project context or authority documents"
require_present "$lfg_skill" "Invoke \`tw-auto\` with the same arguments"
require_present "$lfg_skill" "Do not run \`ce-plan\`, \`ce-work\`, \`ce-code-review\`, \`ce-commit\`"
require_present "$lfg_skill" "Do not fall back to raw CE \`lfg\`"
require_present "$tw_auto_skill" "exactly one review-bearing"
require_present "$tw_auto_skill" "one reviewer persona"
require_present "$tw_auto_skill" "one routine repair-verification cycle"
require_present "$tw_auto_skill" "two is the absolute maximum"
require_present "$tw_auto_skill" "held_no_progress"
require_present "$tw_auto_skill" "tw-commit-push-pr"
require_present "$tw_auto_skill" "never stages, commits, pushes, opens a PR"
require_absent "$tw_auto_skill" "U9 passed"

refs_before="$(git -C "$repo_root" for-each-ref --format='%(refname) %(objectname)')"
set +e
PYTHONDONTWRITEBYTECODE=1 "$ce_work_unit_cli" init \
  --run-id held-smoke \
  --repo "$repo_root" \
  --prompt-brief "$tmp_dir/nonexistent-brief" \
  --prompt-digest "$(printf '0%.0s' {1..64})" \
  >"$tmp_dir/unit-workspace.out" 2>"$tmp_dir/unit-workspace.err"
unit_workspace_status=$?
"$ce_work_cross_model" held-auth held-workspace held-packet held-digest held-result \
  >"$tmp_dir/cross-model-work.out" 2>"$tmp_dir/cross-model-work.err"
cross_model_work_status=$?
"$ce_doc_review_cross_model" held-provider held-candidates held-lens held-doc held-type held-origin held-run \
  >"$tmp_dir/cross-model-doc.out" 2>"$tmp_dir/cross-model-doc.err"
cross_model_doc_status=$?
"$ce_brainstorm_elevation" held-model held-prompt held-result \
  >"$tmp_dir/brainstorm-elevation.out" 2>"$tmp_dir/brainstorm-elevation.err"
brainstorm_elevation_status=$?
"$ce_plan_elevation" held-model held-prompt held-result \
  >"$tmp_dir/plan-elevation.out" 2>"$tmp_dir/plan-elevation.err"
plan_elevation_status=$?
GH_HOST=github.com bash "$ce_resolve_get_comments" 1 Unrelated/repository \
  >"$tmp_dir/repository-mismatch.out" 2>"$tmp_dir/repository-mismatch.err"
repository_mismatch_status=$?
GH_HOST=github.com bash "$ce_resolve_get_thread" 1 PRRC_test Unrelated/repository \
  >"$tmp_dir/thread-repository-mismatch.out" 2>"$tmp_dir/thread-repository-mismatch.err"
thread_repository_mismatch_status=$?
set -e
refs_after="$(git -C "$repo_root" for-each-ref --format='%(refname) %(objectname)')"

if [ "$unit_workspace_status" -ne 1 ] || ! grep -Fq "REFUSED" "$tmp_dir/unit-workspace.out"; then
  echo "unit_workspace_alpha_hold=failed status=$unit_workspace_status"
  exit 1
fi
if [ "$refs_before" != "$refs_after" ]; then
  echo "unit_workspace_alpha_hold_changed_refs=failed"
  exit 1
fi
if [ "$cross_model_work_status" -ne 2 ] || ! grep -Fq "holds external work egress" "$tmp_dir/cross-model-work.err"; then
  echo "cross_model_work_alpha_hold=failed status=$cross_model_work_status"
  exit 1
fi
if [ "$cross_model_doc_status" -ne 0 ] || ! grep -Fq "cross-model document egress is held" "$tmp_dir/cross-model-doc.err"; then
  echo "cross_model_doc_alpha_hold=failed status=$cross_model_doc_status"
  exit 1
fi
if [ "$brainstorm_elevation_status" -ne 2 ] || ! grep -Fq "off-host model elevation is held" "$tmp_dir/brainstorm-elevation.err"; then
  echo "brainstorm_elevation_alpha_hold=failed status=$brainstorm_elevation_status"
  exit 1
fi
if [ "$plan_elevation_status" -ne 2 ] || ! grep -Fq "off-host model elevation is held" "$tmp_dir/plan-elevation.err"; then
  echo "plan_elevation_alpha_hold=failed status=$plan_elevation_status"
  exit 1
fi
if [ "$repository_mismatch_status" -ne 1 ] || ! grep -Fq "must match the current checkout origin repository" "$tmp_dir/repository-mismatch.err"; then
  echo "pr_repository_origin_binding=failed status=$repository_mismatch_status"
  exit 1
fi
if [ "$thread_repository_mismatch_status" -ne 1 ] || ! grep -Fq "must match the current checkout origin repository" "$tmp_dir/thread-repository-mismatch.err"; then
  echo "thread_repository_origin_binding=failed status=$thread_repository_mismatch_status"
  exit 1
fi
if [ -f "$gh_marker" ]; then
  echo "repository_origin_binding_called_gh=failed"
  cat "$gh_marker"
  exit 1
fi

profile_reviewer_cap=1
profile_active_reviewer_cap=1
profile_persona_cap=1
profile_repair_cycle_cap=1
if [ "$profile_reviewer_cap" -ne 1 ] || [ "$profile_active_reviewer_cap" -ne 1 ] || [ "$profile_persona_cap" -ne 1 ] || [ "$profile_repair_cycle_cap" -ne 1 ]; then
  echo "profile_review_caps=failed"
  exit 1
fi

echo "no_publication_smoke=pass"
echo "reply_to_pr_thread_without_gate=blocked_before_gh"
echo "resolve_pr_thread_without_gate=blocked_before_gh"
echo "reply_to_pr_thread_env_bypass=blocked_before_gh"
echo "resolve_pr_thread_env_bypass=blocked_before_gh"
echo "skill_publication_stop_markers=present"
echo "lfg_delegation=pass"
echo "lfg_no_raw_ce_autopilot=pass"
echo "pr_helper_publication_stop_before_external_mutation=pass"
echo "publication_stop_static_markers=present"
echo "ce_work_external_engine=held_before_dispatch_or_repo_mutation"
echo "ce_off_host_model_egress=held_code_doc_plan_brainstorm_work"
echo "pr_feedback_repository_origin_binding=pass"
echo "profile_review_caps=pass routine=$profile_reviewer_cap active=$profile_active_reviewer_cap personas=$profile_persona_cap repair_cycles=$profile_repair_cycle_cap"
echo "u9_runtime=held_out_of_scope"
echo "publication_deploy_dogfood=held_without_separate_authority"
