#!/usr/bin/env bash
set -euo pipefail

# TRACEWEAVER: file-role=traceweaver-no-publication-smoke; req=REQ-TW-043; trace=TRACE-TW-013; ver=VER-TW-022
# TRACEWEAVER: verifies=VER-TW-022; req=REQ-TW-043; trace=TRACE-TW-013
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

gh_marker="$tmp_dir/gh-called"
mkdir -p "$tmp_dir/bin"
cat >"$tmp_dir/bin/gh" <<'SH'
#!/usr/bin/env bash
echo "gh called: $*" >>"${TRACEWEAVER_GH_MARKER:?}"
exit 98
SH
chmod +x "$tmp_dir/bin/gh"

export PATH="$tmp_dir/bin:$PATH"
export TRACEWEAVER_GH_MARKER="$gh_marker"
unset TRACEWEAVER_PUBLICATION_GATE

reply_script="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/reply-to-pr-thread"
resolve_script="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/scripts/resolve-pr-thread"

set +e
printf 'draft reply with no publication\n' | "$reply_script" THREAD_test >"$tmp_dir/reply.out" 2>"$tmp_dir/reply.err"
reply_status=$?
"$resolve_script" THREAD_test >"$tmp_dir/resolve.out" 2>"$tmp_dir/resolve.err"
resolve_status=$?
export TRACEWEAVER_PUBLICATION_GATE=approved
printf 'draft reply with attempted bypass\n' | "$reply_script" THREAD_bypass >"$tmp_dir/reply-bypass.out" 2>"$tmp_dir/reply-bypass.err"
reply_bypass_status=$?
"$resolve_script" THREAD_bypass >"$tmp_dir/resolve-bypass.out" 2>"$tmp_dir/resolve-bypass.err"
resolve_bypass_status=$?
set -e

if [ "$reply_status" -ne 2 ]; then
  echo "reply_to_pr_thread_expected_exit_2=failed actual=$reply_status"
  exit 1
fi

if [ "$resolve_status" -ne 2 ]; then
  echo "resolve_pr_thread_expected_exit_2=failed actual=$resolve_status"
  exit 1
fi

if [ "$reply_bypass_status" -ne 2 ]; then
  echo "reply_to_pr_thread_bypass_expected_exit_2=failed actual=$reply_bypass_status"
  exit 1
fi

if [ "$resolve_bypass_status" -ne 2 ]; then
  echo "resolve_pr_thread_bypass_expected_exit_2=failed actual=$resolve_bypass_status"
  exit 1
fi

if [ -f "$gh_marker" ]; then
  echo "gh_invocation=failed"
  cat "$gh_marker"
  exit 1
fi

require_present() {
  local file="$1"
  local pattern="$2"
  if ! grep -Fq "$pattern" "$file"; then
    echo "required_marker_missing file=$file pattern=$pattern"
    exit 1
  fi
}

require_absent() {
  local file="$1"
  local pattern="$2"
  if grep -Fq "$pattern" "$file"; then
    echo "forbidden_publication_marker_present file=$file pattern=$pattern"
    exit 1
  fi
}

ce_commit_skill="$repo_root/plugins/traceweaver-core/skills/ce-commit/SKILL.md"
ce_debug_skill="$repo_root/plugins/traceweaver-core/skills/ce-debug/SKILL.md"
ce_compound_refresh_skill="$repo_root/plugins/traceweaver-core/skills/ce-compound-refresh/SKILL.md"
ce_resolve_pr_feedback_skill="$repo_root/plugins/traceweaver-core/skills/ce-resolve-pr-feedback/SKILL.md"
tw_grill_skill="$repo_root/plugins/traceweaver-core/skills/tw-grill/SKILL.md"
lfg_skill="$repo_root/plugins/traceweaver-core/skills/lfg/SKILL.md"
tw_auto_skill="$repo_root/plugins/traceweaver-core/skills/tw-auto/SKILL.md"

require_present "$ce_commit_skill" "direct invocation"
require_present "$ce_debug_skill" "stop before staging, committing, pushing, opening PRs"
require_present "$ce_debug_skill" "#### Skill-owned branch (created in Phase 3): TraceWeaver alpha stop"
require_present "$ce_debug_skill" "Do not stage, commit, push, open a PR, post issue/PR replies"
require_present "$ce_debug_skill" 'draft the `/ce-compound` learning-capture handoff'
require_absent "$ce_debug_skill" "default to commit-and-PR without prompting"
require_absent "$ce_debug_skill" 'Run `/ce-commit-push-pr`'
require_absent "$ce_debug_skill" 'Commit and open a PR (`/ce-commit-push-pr`)'
require_absent "$ce_debug_skill" "commit the resulting learning doc to the same branch and push"

require_present "$ce_compound_refresh_skill" "## Phase 5: TraceWeaver Alpha Stop Before Commit"
require_present "$ce_compound_refresh_skill" "Do not stage files, create commits, create branches, push, or open PRs."
require_present "$ce_compound_refresh_skill" "Report follow-up commit content without publishing"
require_absent "$ce_compound_refresh_skill" "## Phase 5: Commit Changes"
require_absent "$ce_compound_refresh_skill" "Create a branch named for what was refreshed"
require_absent "$ce_compound_refresh_skill" "Commit as a separate commit on the current branch"
require_absent "$ce_compound_refresh_skill" "Create a branch, commit, and open a PR"
require_absent "$ce_compound_refresh_skill" "Commit only the compound-refresh changes"
require_absent "$ce_compound_refresh_skill" "Amend or create a follow-up commit when"
require_absent "$ce_compound_refresh_skill" "push the follow-up commit as well"
require_absent "$ce_compound_refresh_skill" "committed as part of (or immediately after) the Phase 5 commit flow"
require_absent "$ce_compound_refresh_skill" "clean up citations in the same commit"

require_present "$ce_resolve_pr_feedback_skill" "posting PR comments, or resolving review threads"
require_present "$tw_grill_skill" "Do not edit project context or authority documents"
require_present "$lfg_skill" "Invoke \`tw-auto\` with the same arguments"
require_present "$lfg_skill" "Do not run \`ce-plan\`, \`ce-work\`, \`ce-code-review\`, \`ce-commit\`"
require_present "$lfg_skill" "Do not fall back to raw CE \`lfg\`"
require_present "$tw_auto_skill" "at most two active"
require_present "$tw_auto_skill" "at most three personas"
require_present "$tw_auto_skill" "no more than two repair cycles"
require_present "$tw_auto_skill" "held_no_progress"
require_present "$tw_auto_skill" "tw-commit-push-pr"
require_present "$tw_auto_skill" "never stages, commits, pushes, opens a PR"
require_absent "$tw_auto_skill" "U9 passed"

profile_reviewer_cap=1
profile_active_reviewer_cap=2
profile_persona_cap=3
profile_repair_cycle_cap=2
if [ "$profile_reviewer_cap" -ne 1 ] || [ "$profile_active_reviewer_cap" -ne 2 ] || [ "$profile_persona_cap" -ne 3 ] || [ "$profile_repair_cycle_cap" -ne 2 ]; then
  echo "profile_review_caps=failed"
  exit 1
fi

echo "no_publication_smoke=pass"
echo "reply_to_pr_thread_without_gate=blocked_before_gh"
echo "resolve_pr_thread_without_gate=blocked_before_gh"
echo "reply_to_pr_thread_env_bypass=blocked_before_gh"
echo "resolve_pr_thread_env_bypass=blocked_before_gh"
echo "skill_publication_stop_markers=present"
echo "lfg_delegation=pass"
echo "lfg_no_raw_ce_autopilot=pass"
echo "pr_helper_publication_stop_before_external_mutation=pass"
echo "publication_stop_static_markers=present"
echo "profile_review_caps=pass routine=$profile_reviewer_cap active=$profile_active_reviewer_cap personas=$profile_persona_cap repair_cycles=$profile_repair_cycle_cap"
echo "u9_runtime=held_out_of_scope"
echo "publication_deploy_dogfood=held_without_separate_authority"
